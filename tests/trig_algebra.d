private Syntax syntax(){ Syntax s; s.declare("b:ℝ,x:ℝ,y:ℝ,z:ℂ,w:ℂ,k:ℤ,m:ℤ,n:ℕ"); return s; }
unittest{
	size_t failures;
	foreach(c;examples()){
		auto owner=Session.open(); auto a=owner.arena; auto s=syntax();
		Term[] facts; foreach(f;c.facts) facts~=s.parse(a,f);
		auto input=s.parse(a,c.input),expected=c.input==c.expected?input:simplify(a,s.parse(a,c.expected,a.sort(input)),facts).output;
		auto fast=simplify(a,input,facts),checked=simplify(a,input,facts,Options(DensityMode.preserve,true));
		if(fast.exhausted||fast.output!=expected){
			writeln("FAIL ",c.name,": ",s.format(a,fast.output),"; expected ",s.format(a,expected),fast.exhausted?" (exhausted)":""); ++failures;
		}
		assert(fast.output==checked.output&&fast.exhausted==checked.exhausted,c.name);
		if(!fast.exhausted) assert(simplify(a,fast.output,facts).output==fast.output,c.name~" is not idempotent");
		exportLean(a,checked);
	}
	assert(!failures,"trigonometric algebra regressions");
}
@system void main(string[] args){
	enforce(args.length==2,"usage: trig-algebra-tests DIRECTORY"); mkdirRecurse(args[1]);
	foreach(c;examples()){
		auto owner=Session.open(); auto a=owner.arena; auto s=syntax();
		Term[] facts; foreach(f;c.facts) facts~=s.parse(a,f);
		write(buildPath(args[1],c.name~".lean"),exportLean(a,simplify(a,s.parse(a,c.input),facts,Options(DensityMode.preserve,true))));
	}
	writeln("Wrote ",examples().length," trigonometric algebra certificates.");
}

unittest{
	foreach(f;["asin","atanh"]) foreach(v;[-2,-1,0,1,2]){
		auto owner=Session.open(); auto a=owner.arena; auto s=syntax();
		auto input=s.parse(a,"sign("~f~"("~to!string(v)~"))");
		auto d=simplifyDomain(a,input);
		enforce(!d.exhausted&&d.output==a.boolean(f=="asin"?v>=-1&&v<=1:v==0),"sign composition original domain");
	}
}

unittest{
	foreach(f;["abs","sign"]) foreach(v;[-1,0,1]){
		auto owner=Session.open(); auto a=owner.arena; auto s=syntax();
		foreach(arg;["1/"~to!string(v),"log("~to!string(v)~")"]){
			auto input=s.parse(a,f~"(cbrt("~arg~"))");
			auto d=simplifyDomain(a,input);
			enforce(!d.exhausted&&d.output==a.boolean(arg[0]=='1'?v!=0:v>0),"cube root composition original domain");
			auto masked=s.parse(a,"[false]*"~f~"(cbrt("~arg~"))");
			auto md=simplifyDomain(a,masked);
			enforce(!md.exhausted&&md.output==a.boolean(true),"cube root composition false guard domain");
		}
	}
}

