rule σύγκρουση(α:ℝ,u_ceb1:ℝ):(α+u_ceb1)+0⇒α+u_ceb1;
rule απλό(ρ₁':ℝ):ρ₁'+0⇒ρ₁';
rule theorem(Expr:ℂ):1×Expr⇒Expr;
rule bare_false():[false]⇒0;
rule bare_true():[true]⇒1;
rule complex_bare_false():[false]⇒complex(0,0);
rule guarded(p:𝔹,x:ℝ):[p]·x+0⇒mask(p,x);
rule inverse(x:ℝ):⅟x+0⇒x⁻¹;
rule imaginary():[false]·ⅈ⇒complex(0,0);
rule minimum():[false]·(-9223372036854775808)⇒0;
rule minimum_result():[true]·(-9223372036854775808)⇒-9223372036854775808;
rule nonzero(x:ℝ):([x≠0]·x⁻¹)+0⇒maskR(nonzeroR(x),invR(x));
rule power(x:ℝ):x³+0⇒x^3;
rule interval(x:ℝ):[0≤x<1]+0⇒[0≤x∧x<1];
rule absolute(x:ℝ):|x|+0⇒absR(x);
equation association(x:ℝ,y:ℝ,z:ℝ):(x+y)+z≡x+(y+z);
lemma split_power(x:ℂ,m:NatParam,n:NatParam):x^(m+n)⇒x^m·x^n;
rewrite signed_abs(x:ℝ):|x|⇒x when 0≤x;
fact even_power(x:ℝ,n:NatParam):0≤x^(n+n);
lemma defined_quotient(p:ℝ,d:ℝ,q:ℝ):p/d⇒q+(p−q·d)/d when defined(q);
rewrite shifted(x:ℝ,a:ℝ,b:ℝ):x+a<b⇒x<b−a when literal(a),literal(b);
rule nat_literal(n:NatParam):nat(n)+nat(0)⇒nat(n);
rule int_literal(n:NatParam):int(n)·int(1)⇒int(n);
rule rat_literal(n:NatParam,d:NatParam):rat(n,d)+rat(0,1)⇒rat(n,d);
rewrite imaginary_literal(n:NatParam):conj(complex(0,n))⇒complex(0,0)-complex(0,n);
rule real_power_literal(x:ℝ,n:NatParam):pow(x,real(n))⇒x^n;
rule complex_sine_zero():sin(complex(0,0))⇒complex(0,0);
rule rational_real():real(1,2)+real(1,2)⇒1;
