module rulec;
import qsym.ir;
import qsym.spec;
import qsym.table:Table;
import std.file:readText,write;
import std.conv:to;
import std.array:join;
import std.stdio:stderr,writeln;
import std.exception:enforce;
@safe:

string dOp(string n){
	switch(n){
		case "real":return "realLit";
		case "complex":return "complexLit";
		case "true","false":return "boolLit";
		case "addR","addC":return "add";
		case "mulR","mulC":return "mul";
		case "invR","invC":return "inv";
		case "nonzeroR","nonzeroC":return "nonzero";
		case "powR","powC":return "pow";
		case "ltR":return "lt";
		case "leR":return "le";
		case "not","and","or":return n~"_";
		case "maskR","maskC":return "mask";
		default:return n;
	}
}
string dInteger(long n){ return n==long.min?"long.min":to!string(n)~"L"; }
string dPattern(Pattern p){
	if(p.variable) return parameterCode(p.name);
	if(p.name=="powR"||p.name=="powC") return "a.pow("~dPattern(p.args[0])~","~to!string(p.args[1].number)~"u)";
	if(p.name=="#") return "("~dInteger(p.number)~")";
	if(p.name=="true"||p.name=="false") return "a.boolean("~p.name~")";
	string[] args;
	foreach(arg;p.args) args~=dPattern(arg);
	auto name=p.name=="real"||p.name=="complex"?p.name:dOp(p.name);
	if(name=="real") name="real_";
	return "a."~name~"("~args.join(",")~")";
}
void matchPattern(Pattern p,string path,ref string[] checks,ref Table!(string,string) bindings){
	if(p.variable){
		if(bindings.contains(p.name)) checks~=path~"=="~bindings.get(p.name,"");
		else bindings.set(p.name,path);
		return;
	}
	checks~="a.node("~path~").op==Op."~dOp(p.name);
	checks~="a.sort("~path~")==Sort."~to!string(p.sort);
	if(p.name=="real"||p.name=="complex"){
		checks~="a.node("~path~").value=="~dInteger(p.args[0].number);
		if(p.name=="complex") checks~="a.node("~path~").imaginary=="~dInteger(p.args[1].number);
	}else if(p.name=="true"||p.name=="false"){
		checks~="a.node("~path~").value=="~(p.name=="true"?"1":"0");
	}else if(p.name=="powR"||p.name=="powC"){
		checks~="a.node("~path~").value=="~dInteger(p.args[1].number);
		matchPattern(p.args[0],"a.child("~path~",0)",checks,bindings);
	}else{
		foreach(i,arg;p.args)
			matchPattern(arg,"a.child("~path~","~to!string(i)~")",checks,bindings);
	}
}

string emitD(Rule[] rules){
	string d="// Generated by rulec; edit rules/core.qs.\nmodule qsym.generated.rules;\nimport qsym.ir;\n@safe:\n"~
		"struct Rewrite{ bool applied; Term result; string rule; Term[] bindings; }\n"~
		"Rewrite rewrite(Arena a,Term root,bool trace){\n\tswitch(a.node(root).op){\n";
	string[] ops;
	foreach(r;rules){
		auto op=dOp(r.lhs.name);
		bool found; foreach(old;ops) if(old==op) found=true;
		if(!found) ops~=op;
	}
	foreach(op;ops){
		d~="\t\tcase Op."~op~":\n";
		foreach(r;rules) if(dOp(r.lhs.name)==op){
			string[] checks; Table!(string,string) bindings;
			matchPattern(r.lhs,"root",checks,bindings);
			d~="\t\t\tif("~checks.join("&&")~"){\n";
			string[] args;
			foreach(v;r.parameters){
				d~="\t\t\t\tauto "~parameterCode(v.name)~"="~bindings.get(v.name,"")~";\n";
				args~=parameterCode(v.name);
			}
			auto traceArgs=args.length?"trace?["~args.join(",")~"]:null":"null";
			d~="\t\t\t\treturn Rewrite(true,"~dPattern(r.rhs)~",\""~ruleCode(r.name)~
				"\","~traceArgs~");\n\t\t\t}\n";
		}
		d~="\t\t\tbreak;\n";
	}
	return d~"\t\tdefault:break;\n\t}\n\treturn Rewrite(false,root);\n}\n";
}

string emitLean(Rule[] rules){
	string lean="-- Generated by rulec; every declaration must pass the Lean kernel.\n"~
		"import QSym.Refinement\nnamespace QSym.Generated\n";
	foreach(r;rules){
		lean~="theorem "~ruleCode(r.name)~" (ρ : Env)";
		foreach(v;r.parameters) lean~=" ("~parameterCode(v.name)~" : Expr ."~leanSort(v.sort)~")";
		lean~=" :\n    Value.Refines (Expr.eval ρ "~leanPattern(r.lhs)~") (Expr.eval ρ "~leanPattern(r.rhs)~") := by\n";
		lean~="  qsym_rule\n\n";
		lean~="#print axioms "~ruleCode(r.name)~"\n\n";
	}
	return lean~"end QSym.Generated\n";
}

@system int main(string[] args){
	try{
		enforce(args.length==4,"usage: rulec INPUT.qs OUTPUT.d OUTPUT.lean");
		auto rules=Parser(readText(args[1])).parse();
		auto d=emitD(rules),lean=emitLean(rules);
		write(args[2],d); write(args[3],lean);
		writeln("Generated ",rules.length," rules; Lean checking is required before trusting them.");
		return 0;
	}catch(Exception e){ stderr.writeln(e.msg); return 1; }
}
