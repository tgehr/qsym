lemma real_mul_inv(x:ℝ,y:ℝ):x⁻¹·y⁻¹⇒(x·y)⁻¹;
lemma real_cancel_factor(x:ℝ,y:ℝ):(x·y)·x⁻¹⇒y;
rewrite real_mask_add(p:𝔹,x:ℝ,y:ℝ):[p]·x+[p]·y⇒[p]·(x+y);
rewrite real_mask_complement(p:𝔹,x:ℝ):[p]·x+[¬p]·x⇒x;
