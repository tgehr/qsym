rule real_abs_neg(x:ℝ):|−x|⇒|x|;
equation real_add_assoc(x:ℝ,y:ℝ,z:ℝ):(x+y)+z≡x+(y+z);
equation real_add_comm(x:ℝ,y:ℝ):x+y≡y+x;
equation real_add_unit(x:ℝ):x+0≡x;
