rewrite complex_norm_nonpositive(z:ℂ):cabs(z)≤0⇒z=0;
rule complex_norm_negative(z:ℂ):cabs(z)<0⇒false;
fact complex_norm_nonnegative(z:ℂ):0≤cabs(z);
rewrite complex_norm_mask(p:𝔹,z:ℂ):cabs([p]*z)⇒[p]*cabs(z);
