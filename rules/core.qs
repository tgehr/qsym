rule log_exp_real(x:ℝ):log(exp(x))⇒x;
rule exp_log_complex(z:ℂ):cexp(clog(z))⇒z;
rule sqrt_square_real(x:ℝ):sqrt(x^2)⇒abs(x);
rule real_part_cartesian(x:ℝ,y:ℝ):creal(cfromri(x,y))⇒x;
rule imag_part_cartesian(x:ℝ,y:ℝ):cimag(cfromri(x,y))⇒y;
rule bool_eq_true(p:𝔹):eqB(p,true)⇒p;
rule bool_eq_false(p:𝔹):eqB(p,false)⇒¬p;

# Elementary identities; partial functions retain their defined-input semantics.
rule real_exp_product(x:ℝ,y:ℝ):exp(x)·exp(y)⇒exp(x+y);
rule complex_exp_product(x:ℂ,y:ℂ):exp(x)·exp(y)⇒exp(x+y);
rewrite real_exp_quotient(x:ℝ,y:ℝ):exp(x)·exp(y)⁻¹⇒exp(x-y);
rewrite complex_exp_quotient(x:ℂ,y:ℂ):exp(x)·exp(y)⁻¹⇒exp(x-y);
rewrite real_exp_power(x:ℝ,n:NatParam):exp(x)^n⇒exp(real(n)·x);
rewrite complex_exp_power(x:ℂ,n:NatParam):exp(x)^n⇒exp(complex(n,0)·x);
rule real_exp_base(x:ℝ):powerR(e,x)⇒exp(x);
fact real_positive_exp(x:ℝ):0<exp(x);
fact real_nonnegative_sqrt(x:ℝ):0≤sqrt(x);
fact real_positive_pi():0<π;
fact real_positive_e():0<e;
rewrite real_log_product(x:ℝ,y:ℝ):log(x·y)⇒log(x)+log(y) when 0<x,0<y;
rewrite real_log_power(x:ℝ,n:NatParam):log(x^n)⇒real(n)·log(x) when 0<x;
rewrite real_log_square(x:ℝ):log(x^2)⇒2·log(abs(x));
rewrite real_log_inverse(x:ℝ):log(x⁻¹)⇒-log(x) when 0<x;
rewrite real_log_sqrt(x:ℝ):log(sqrt(x))⇒real(1,2)·log(x) when 0<x;
rule real_half_power(x:ℝ):powerR(x,real(1,2))⇒sqrt(x);
rule real_sqrt_squared(x:ℝ):sqrt(x)^2⇒x;
lemma real_sqrt_exact(x:ℝ,y:ℝ):sqrt(x)⇒y when y^2=x,0≤y,defined(y);
lemma real_power_exact(x:ℝ,y:ℝ,z:ℝ,m:NatParam,n:NatParam):powerR(x,z)⇒y^m when z=real(m)/(real(n)+1),y^(n+1)=x,0≤y,defined(y);
rule real_general_power_product(x:ℝ,y:ℝ,z:ℝ):powerR(x,y)·powerR(x,z)⇒powerR(x,y+z) when 0<x;
rewrite real_general_power_nested(x:ℝ,y:ℝ,z:ℝ):powerR(powerR(x,y),z)⇒powerR(x,y·z) when 0<x;
rule real_one_power(x:ℝ):powerR(1,x)⇒1;
rule complex_one_power(z:ℂ):powerC(1,z)⇒complex(1,0);
rule real_zero_power(x:ℝ):powerR(0,x)⇒0 when 0<x;
rule real_min_left(x:ℝ,y:ℝ):min(x,y)⇒x when x≤y;
rule real_min_right(x:ℝ,y:ℝ):min(x,y)⇒y when y≤x;
rule real_max_left(x:ℝ,y:ℝ):max(x,y)⇒x when y≤x;
rule real_max_right(x:ℝ,y:ℝ):max(x,y)⇒y when x≤y;
rewrite real_sign_positive(x:ℝ):sign(x)⇒int(1) when 0<x;
rewrite real_sign_negative(x:ℝ):sign(x)⇒int(-1) when x<0;
rewrite real_sign_zero(x:ℝ):sign(x)⇒int(0) when x=0;
rule real_trig_identity(x:ℝ):sin(x)^2+cos(x)^2⇒1;
rule complex_trig_identity(z:ℂ):sin(z)^2+cos(z)^2⇒complex(1,0);
rewrite real_sin_neg(x:ℝ):sin(-x)⇒-sin(x);
rule real_cos_neg(x:ℝ):cos(-x)⇒cos(x);
rewrite real_tan_neg(x:ℝ):tan(-x)⇒-tan(x);
rewrite complex_sin_neg(z:ℂ):sin(-z)⇒-sin(z);
rule complex_cos_neg(z:ℂ):cos(-z)⇒cos(z);
rewrite real_sinh_neg(x:ℝ):sinh(-x)⇒-sinh(x);
rule real_cosh_neg(x:ℝ):cosh(-x)⇒cosh(x);
rule real_hyperbolic_identity(x:ℝ):cosh(x)^2-sinh(x)^2⇒1;
rule real_tan_atan(x:ℝ):tan(atan(x))⇒x;
rule real_sin_asin(x:ℝ):sin(asin(x))⇒x;
rule real_cos_acos(x:ℝ):cos(acos(x))⇒x;
rule real_asin_sin(x:ℝ):asin(sin(x))⇒x when -real(1,2)·π≤x,x≤real(1,2)·π;
rule real_acos_cos(x:ℝ):acos(cos(x))⇒x when 0≤x,x≤π;
rule real_sin_pi():sin(π)⇒0;
rule real_cos_pi():cos(π)⇒-1;
rule real_sin_half_pi():sin(real(1,2)·π)⇒1;
rule real_cos_half_pi():cos(real(1,2)·π)⇒0;
rule real_sin_three_half_pi():sin(real(3,2)·π)⇒-1;
rule real_cos_three_half_pi():cos(real(3,2)·π)⇒0;
rule real_sin_sixth_pi():sin(real(1,6)·π)⇒real(1,2);
rule real_cos_third_pi():cos(real(1,3)·π)⇒real(1,2);
rewrite real_cos_quarter_pi():cos(real(1,4)·π)⇒real(1,2)·sqrt(2);
rewrite real_sin_quarter_pi():sin(real(1,4)·π)⇒real(1,2)·sqrt(2);
lemma real_sin_period(x:ℝ,n:ℤ):sin(x)⇒sin(x-toℝ(n)·(2·π)) when defined(n);
lemma real_cos_period(x:ℝ,n:ℤ):cos(x)⇒cos(x-toℝ(n)·(2·π)) when defined(n);
rewrite complex_exp_conj(z:ℂ):conj(exp(z))⇒exp(conj(z));
rewrite real_part_sum(z:ℂ,w:ℂ):creal(z+w)⇒creal(z)+creal(w);
rewrite imaginary_part_sum(z:ℂ,w:ℂ):cimag(z+w)⇒cimag(z)+cimag(w);
rewrite real_part_product(z:ℂ,w:ℂ):creal(z·w)⇒creal(z)·creal(w)-cimag(z)·cimag(w);
rewrite imaginary_part_product(z:ℂ,w:ℂ):cimag(z·w)⇒creal(z)·cimag(w)+cimag(z)·creal(w);
rule real_part_cast(x:ℝ):creal(toℂ(x))⇒x;
rule imaginary_part_cast(x:ℝ):cimag(toℂ(x))⇒0;
rule complex_reconstruction(z:ℂ):cfromri(creal(z),cimag(z))⇒z;
rewrite complex_norm_product(z:ℂ,w:ℂ):cabs(z·w)⇒cabs(z)·cabs(w);
rule complex_norm_conj(z:ℂ):cabs(conj(z))⇒cabs(z);
rule complex_phase_product(x:ℝ,y:ℝ):cis(x)·cis(y)⇒cis(x+y);
rule complex_phase_norm(x:ℝ):cabs(cis(x))⇒1;
rewrite complex_exp_phase(z:ℂ):cexp(z)⇒cis(cimag(z)) when creal(z)=0;
rule complex_phase_pi():cis(π)⇒complex(-1,0);
rule complex_phase_half_pi():cis(real(1,2)·π)⇒ⅈ;
lemma complex_phase_period(x:ℝ,n:ℤ):cis(x)⇒cis(x-toℝ(n)·(2·π)) when defined(n);
lemma real_solve_affine(x:ℝ,a:ℝ,b:ℝ):x⇒-b/a when a·x+b=0,a≠0,defined(a),defined(b);
lemma complex_solve_affine(x:ℂ,a:ℂ,b:ℂ):x⇒-b/a when a·x+b=0,a≠0,defined(a),defined(b);

lemma real_floor_exact(x:ℝ,n:ℤ):floor(x)⇒n when toℝ(n)≤x,x<toℝ(n)+1,defined(n);
lemma real_ceil_exact(x:ℝ,n:ℤ):ceil(x)⇒n when toℝ(n)-1<x,x≤toℝ(n),defined(n);
rewrite real_round(x:ℝ):round(x)⇒floor(x+real(1,2));
rewrite real_is_integer(x:ℝ):inZ(x)⇒x=toℝ(floor(x));
rewrite real_hypot(x:ℝ,y:ℝ):hypot(x,y)⇒sqrt(x^2+y^2);
# Principal-branch identities; real powers in (0,1] cannot wrap the argument.
rewrite complex_arg_real_power(z:ℂ,w:ℂ):carg(powerC(z,w))⇒creal(w)*carg(z) when cimag(w)=0,0<creal(w),creal(w)≤1;
rewrite complex_log_real_power(z:ℂ,w:ℂ):clog(powerC(z,w))⇒w*clog(z) when cimag(w)=0,0<creal(w),creal(w)≤1;
rewrite complex_arg_sqrt(z:ℂ):carg(csqrt(z))⇒real(1,2)*carg(z);
rewrite complex_log_sqrt(z:ℂ):clog(csqrt(z))⇒clog(z)/2;
rewrite complex_norm_sqrt(z:ℂ):cabs(csqrt(z))⇒sqrt(cabs(z));
rewrite complex_sqrt_squared(z:ℂ):csqrt(z)^2⇒z;
rewrite complex_norm_real_power(z:ℂ,w:ℂ):cabs(powerC(z,w))⇒powerR(cabs(z),creal(w)) when cimag(w)=0;
rewrite complex_norm_exp(z:ℂ):cabs(cexp(z))⇒exp(creal(z));
rewrite complex_norm_inverse(z:ℂ):cabs(z⁻¹)⇒cabs(z)⁻¹;
rewrite complex_norm_power(z:ℂ,n:NatParam):cabs(z^n)⇒cabs(z)^n;
rewrite complex_norm_cast(x:ℝ):cabs(toℂ(x))⇒abs(x);
rewrite complex_log_real_part(z:ℂ):creal(clog(z))⇒log(cabs(z));
rewrite complex_log_imaginary_part(z:ℂ):cimag(clog(z))⇒carg(z);
rewrite complex_log_exp(z:ℂ):clog(cexp(z))⇒z when -π<cimag(z),cimag(z)≤π;
rewrite complex_arg_exp(z:ℂ):carg(cexp(z))⇒cimag(z) when -π<cimag(z),cimag(z)≤π;
rewrite complex_arg_phase(x:ℝ):carg(cis(x))⇒x when -π<x,x≤π;
rewrite real_sinh_asinh(x:ℝ):sinh(asinh(x))⇒x;
rewrite real_asinh_sinh(x:ℝ):asinh(sinh(x))⇒x;
rewrite real_cos_asin(x:ℝ):cos(asin(x))⇒sqrt(1-x^2);
rewrite real_sin_acos(x:ℝ):sin(acos(x))⇒sqrt(1-x^2);
rewrite complex_sin_conj(z:ℂ):conj(csin(z))⇒csin(conj(z));
rewrite complex_cos_conj(z:ℂ):conj(ccos(z))⇒ccos(conj(z));
rewrite complex_sinh_conj(z:ℂ):conj(csinh(z))⇒csinh(conj(z));
rewrite complex_cosh_conj(z:ℂ):conj(ccosh(z))⇒ccosh(conj(z));
rewrite complex_abs_cartesian(z:ℂ):cabs(z)⇒sqrt(creal(z)^2+cimag(z)^2);
rewrite real_cbrt_nonnegative(x:ℝ):cbrt(x)⇒powerR(x,real(1,3)) when 0≤x;
rewrite real_cbrt_negative(x:ℝ):cbrt(x)⇒-powerR(-x,real(1,3)) when x<0;
rewrite real_exp2(x:ℝ):exp2(x)⇒powerR(2,x);
rewrite real_power_negative(x:ℝ,y:ℝ):powerR(x,y)⇒powerR(x,-y)⁻¹ when y<0;
lemma real_log2_exact(x:ℝ,y:ℝ):log2(x)⇒y when powerR(2,y)=x,defined(y);
lemma real_log10_exact(x:ℝ,y:ℝ):log10(x)⇒y when powerR(10,y)=x,defined(y);
lemma complex_sqrt_exact(z:ℂ,w:ℂ):csqrt(z)⇒w when w^2=z,0<creal(w),defined(w);
lemma complex_sqrt_imaginary(z:ℂ,y:ℝ):csqrt(z)⇒toℂ(y)*ⅈ when toℂ(-y^2)=z,0≤y,defined(y);
rewrite complex_polar(r:ℝ,t:ℝ):cfromrt(r,t)⇒toℂ(r)*cis(t);
rewrite complex_expi(z:ℂ):cexpi(z)⇒exp(ⅈ*z);
rewrite real_atan2(y:ℝ,x:ℝ):atan2(y,x)⇒carg(cfromri(x,y));
rewrite complex_arg_positive(z:ℂ):carg(z)⇒0 when cimag(z)=0,0<creal(z);
rewrite complex_arg_negative(z:ℂ):carg(z)⇒π when cimag(z)=0,creal(z)<0;
rewrite complex_arg_positive_imag(z:ℂ):carg(z)⇒real(1,2)*π when creal(z)=0,0<cimag(z);
rewrite complex_arg_negative_imag(z:ℂ):carg(z)⇒-real(1,2)*π when creal(z)=0,cimag(z)<0;
rule real_exp_one():exp(1)⇒e;
rule real_log_e():log(e)⇒1;
rule real_asin_zero():asin(0)⇒0;
rewrite real_asin_one():asin(1)⇒real(1,2)*π;
rewrite real_acos_zero():acos(0)⇒real(1,2)*π;
rule real_acos_one():acos(1)⇒0;
rule real_acos_neg_one():acos(-1)⇒π;
rule real_atan_zero():atan(0)⇒0;
rewrite real_atan_one():atan(1)⇒real(1,4)*π;
rule real_asinh_zero():asinh(0)⇒0;
rule real_acosh_one():acosh(1)⇒0;
rule real_atanh_zero():atanh(0)⇒0;
rule complex_asin_zero():casin(0)⇒complex(0,0);
rewrite complex_acos_zero():cacos(0)⇒toℂ(real(1,2)*π);
rule complex_atan_zero():catan(0)⇒complex(0,0);
rule complex_asinh_zero():casinh(0)⇒complex(0,0);
rule complex_acosh_one():cacosh(1)⇒complex(0,0);
rule complex_atanh_zero():catanh(0)⇒complex(0,0);
rule real_erf_zero():erf(0)⇒0;
rule real_erfc_zero():erfc(0)⇒1;
rule real_gamma_one():tgamma(1)⇒1;
rule complex_gamma_one():cgamma(1)⇒complex(1,0);
rule real_lgamma_one():lgamma(1)⇒0;
lemma real_gamma_next(x:ℝ,n:NatParam):tgamma(x)⇒(real(n)+1)*tgamma(real(n)+1) when x=(real(n)+2);
lemma complex_gamma_next(x:ℂ,n:NatParam):cgamma(x)⇒(complex(n,0)+1)*cgamma(complex(n,0)+1) when x=(complex(n,0)+2);
rule natural_indexed_power(x:ℕ,n:NatParam):powNN(x,nat(n))⇒x^n;
rule integer_indexed_power(x:ℤ,n:NatParam):powZN(x,nat(n))⇒x^n;
rule rational_indexed_power(x:ℚ,n:NatParam):powQN(x,nat(n))⇒x^n;
rule rational_indexed_integer_power(x:ℚ,n:NatParam):powQZ(x,int(n))⇒x^n;
lemma rational_indexed_negative_power(x:ℚ,y:ℤ,n:NatParam):powQZ(x,y)⇒(x^(n+1))⁻¹ when y=-(int(n)+1);
rule real_indexed_power(x:ℝ,n:NatParam):powRN(x,nat(n))⇒x^n;
rule real_indexed_integer_power(x:ℝ,n:NatParam):powRZ(x,int(n))⇒x^n;
lemma real_indexed_negative_power(x:ℝ,y:ℤ,n:NatParam):powRZ(x,y)⇒(x^(n+1))⁻¹ when y=-(int(n)+1);
rule complex_indexed_power(x:ℂ,n:NatParam):powCN(x,nat(n))⇒x^n;
rule complex_indexed_integer_power(x:ℂ,n:NatParam):powCZ(x,int(n))⇒x^n;
lemma complex_indexed_negative_power(x:ℂ,y:ℤ,n:NatParam):powCZ(x,y)⇒(x^(n+1))⁻¹ when y=-(int(n)+1);
lemma complex_general_negative_power(x:ℂ,y:ℂ,n:NatParam):powerC(x,y)⇒(x^(n+1))⁻¹ when y=-(complex(n,0)+1);
