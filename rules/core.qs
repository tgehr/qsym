rewrite integer_pow_zero(x:ℤ):x^0⇒1;
rule integer_pow_one(x:ℤ):x^1⇒x;
rule integer_mask_true(x:ℤ):[true]·x⇒x;
rule integer_mask_false(x:ℤ):[false]·x⇒0;
rule rational_add_zero(x:ℚ):x+0⇒x;
rule rational_zero_add(x:ℚ):0+x⇒x;
rule rational_mul_one(x:ℚ):x·1⇒x;
rule rational_one_mul(x:ℚ):1·x⇒x;
