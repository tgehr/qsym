lemma real_pow_join(x:ℝ,m:NatParam,n:NatParam):x^m·x^n⇒x^(m+n);
lemma real_pow_product(x:ℝ,y:ℝ,n:NatParam):(x·y)^n⇒x^n·y^n;
lemma real_pow_power(x:ℝ,m:NatParam,n:NatParam):(x^m)^n⇒x^(m·n);
