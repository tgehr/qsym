rule complex_atanh_zero():catanh(0)⇒complex(0,0);
rule real_erf_zero():erf(0)⇒0;
rule real_erfc_zero():erfc(0)⇒1;
rule real_gamma_one():tgamma(1)⇒1;
rule complex_gamma_one():cgamma(1)⇒complex(1,0);
rule real_lgamma_one():lgamma(1)⇒0;
lemma real_gamma_next(x:ℝ,n:NatParam):tgamma(x)⇒(real(n)+1)*tgamma(real(n)+1) when x=(real(n)+2);
lemma complex_gamma_next(x:ℂ,n:NatParam):cgamma(x)⇒(complex(n,0)+1)*cgamma(complex(n,0)+1) when x=(complex(n,0)+2);
rule natural_indexed_power(x:ℕ,n:NatParam):powNN(x,nat(n))⇒x^n;
rule integer_indexed_power(x:ℤ,n:NatParam):powZN(x,nat(n))⇒x^n;
rule rational_indexed_power(x:ℚ,n:NatParam):powQN(x,nat(n))⇒x^n;
rule rational_indexed_integer_power(x:ℚ,n:NatParam):powQZ(x,int(n))⇒x^n;
lemma rational_indexed_negative_power(x:ℚ,y:ℤ,n:NatParam):powQZ(x,y)⇒(x^(n+1))⁻¹ when y=-(int(n)+1);
rule real_indexed_power(x:ℝ,n:NatParam):powRN(x,nat(n))⇒x^n;
rule real_indexed_integer_power(x:ℝ,n:NatParam):powRZ(x,int(n))⇒x^n;
lemma real_indexed_negative_power(x:ℝ,y:ℤ,n:NatParam):powRZ(x,y)⇒(x^(n+1))⁻¹ when y=-(int(n)+1);
rule complex_indexed_power(x:ℂ,n:NatParam):powCN(x,nat(n))⇒x^n;
rule complex_indexed_integer_power(x:ℂ,n:NatParam):powCZ(x,int(n))⇒x^n;
lemma complex_indexed_negative_power(x:ℂ,y:ℤ,n:NatParam):powCZ(x,y)⇒(x^(n+1))⁻¹ when y=-(int(n)+1);
lemma complex_general_negative_power(x:ℂ,y:ℂ,n:NatParam):powerC(x,y)⇒(x^(n+1))⁻¹ when y=-(complex(n,0)+1);

rewrite real_min_lt(x:ℝ,y:ℝ,t:ℝ):min(x,y)<t⇒x<t∨y<t;
rewrite real_min_le(x:ℝ,y:ℝ,t:ℝ):min(x,y)≤t⇒x≤t∨y≤t;
rewrite real_lt_min(x:ℝ,y:ℝ,t:ℝ):t<min(x,y)⇒t<x∧t<y;
rewrite real_le_min(x:ℝ,y:ℝ,t:ℝ):t≤min(x,y)⇒t≤x∧t≤y;
rewrite real_max_lt(x:ℝ,y:ℝ,t:ℝ):max(x,y)<t⇒x<t∧y<t;
rewrite real_max_le(x:ℝ,y:ℝ,t:ℝ):max(x,y)≤t⇒x≤t∧y≤t;
rewrite real_lt_max(x:ℝ,y:ℝ,t:ℝ):t<max(x,y)⇒t<x∨t<y;
rewrite real_le_max(x:ℝ,y:ℝ,t:ℝ):t≤max(x,y)⇒t≤x∨t≤y;
rule real_min_max_sum(x:ℝ,y:ℝ):min(x,y)+max(x,y)⇒x+y;
rule real_min_max_product(x:ℝ,y:ℝ):min(x,y)*max(x,y)⇒x*y;
rule real_min_absorb(x:ℝ,y:ℝ):min(x,max(x,y))⇒x;
rule real_max_absorb(x:ℝ,y:ℝ):max(x,min(x,y))⇒x;
rewrite real_min_max_ne(x:ℝ,y:ℝ):min(x,y)≠max(x,y)⇒x≠y;
rewrite real_inverse_negative(x:ℝ):x⁻¹<0⇒x<0;
rewrite real_inverse_positive(x:ℝ):0<x⁻¹⇒0<x;
rewrite real_inverse_nonnegative(x:ℝ):0≤x⁻¹⇒0≤x;
rewrite real_inverse_nonpositive(x:ℝ):x⁻¹≤0⇒x≤0;
rewrite real_inverse_ne(x:ℝ,y:ℝ):x⁻¹≠y⁻¹⇒x≠y;
rewrite complex_inverse_ne(z:ℂ,w:ℂ):z⁻¹≠w⁻¹⇒z≠w;
lemma real_quotient_add_nonzero(x:ℝ,y:ℝ,z:ℝ):x*y⁻¹+z≠0⇒x+y*z≠0;
lemma complex_quotient_add_nonzero(x:ℂ,y:ℂ,z:ℂ):x*y⁻¹+z≠0⇒x+y*z≠0;

rewrite real_add_lt_cancel(x:ℝ,y:ℝ,t:ℝ):x+t<y+t⇒x<y;
rewrite real_add_le_cancel(x:ℝ,y:ℝ,t:ℝ):x+t≤y+t⇒x≤y;
rewrite real_abs_even_power(x:ℝ,n:NatParam):abs(x)^(n+n)⇒x^(n+n);
rewrite real_log_even_power(x:ℝ,n:NatParam):log(x^(n+n+2))⇒2*(real(n)+1)*log(abs(x));
rewrite real_exp_log_scale(x:ℝ,y:ℝ):exp(y*log(x))⇒powerR(x,y);
rewrite real_exp_log_scale_right(x:ℝ,y:ℝ):exp(log(x)*y)⇒powerR(x,y);
rewrite real_exp_log_sum(x:ℝ,y:ℝ):exp(log(x)+y)⇒x*exp(y);
rewrite real_exp_log_sum_right(x:ℝ,y:ℝ):exp(y+log(x))⇒x*exp(y);
rewrite real_exp_log_affine(x:ℝ,y:ℝ,t:ℝ):exp(t+y*log(x))⇒exp(t)*powerR(x,y);
rewrite real_exp_log_affine_left(x:ℝ,y:ℝ,t:ℝ):exp(y*log(x)+t)⇒powerR(x,y)*exp(t);
rule real_sqrt_product(x:ℝ,y:ℝ):sqrt(x)*sqrt(y)⇒sqrt(x*y);
rule real_power_product_base(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)*powerR(y,t)⇒powerR(x*y,t) when 0≤x,0≤y;
