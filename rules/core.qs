rule rational_mask_true(x:ℚ):[true]·x⇒x;
rule rational_mask_false(x:ℚ):[false]·x⇒0;
rule natural_nonnegative(n:ℕ):0≤n⇒true;
rule rational_inv_inv(x:ℚ):(x⁻¹)⁻¹⇒x;
rule real_general_power(x:ℝ,n:NatParam):powerR(x,real(n))⇒x^n;
rule complex_general_power(x:ℂ,n:NatParam):powerC(x,complex(n,0))⇒x^n;
rule expR_zero():expR(0)⇒1;
rule expC_zero():expC(0)⇒complex(1,0);
rule sinR_zero():sinR(0)⇒0;
rule sinC_zero():sinC(0)⇒complex(0,0);
