rewrite complex_pow_zero(x:ℂ):x^0⇒1;
rule complex_pow_one(x:ℂ):x^1⇒x;
lemma complex_divide_step(p:ℂ,d:ℂ,q:ℂ):p·d⁻¹⇒q+(p−q·d)·d⁻¹ when defined(q);
rewrite complex_nonzero_power(x:ℂ,n:NatParam):x^(n+1)≠0⇒x≠0;
rewrite complex_conj_add(x:ℂ,y:ℂ):conj(x+y)⇒conj(x)+conj(y);
rewrite complex_conj_mul(x:ℂ,y:ℂ):conj(x·y)⇒conj(x)·conj(y);
rewrite complex_conj_inv(x:ℂ):conj(x⁻¹)⇒conj(x)⁻¹;
rewrite complex_conj_pow(x:ℂ,n:NatParam):conj(x^n)⇒conj(x)^n;
rewrite complex_conj_mask(p:𝔹,x:ℂ):conj([p]·x)⇒[p]·conj(x);
rule complex_nonzero_conj(x:ℂ):conj(x)≠0⇒x≠0;
rule real_abs_nonnegative(x:ℝ):abs(x)⇒x when 0≤x;
rewrite real_abs_nonpositive(x:ℝ):abs(x)⇒−x when x≤0;
rewrite real_abs_product(x:ℝ,y:ℝ):|x·y|⇒|x|·|y|;
rewrite real_abs_inverse(x:ℝ):abs(x⁻¹)⇒abs(x)⁻¹;
rewrite real_abs_power(x:ℝ,n:NatParam):abs(x^n)⇒abs(x)^n;
rewrite real_abs_mask(p:𝔹,x:ℝ):abs([p]·x)⇒[p]·abs(x);
rule real_nonzero_abs(x:ℝ):abs(x)≠0⇒x≠0;
lemma real_known_zero(x:ℝ):x⇒0 when x=0;
rule bool_not_not(p:𝔹):¬¬p⇒p;
rule bool_not_true():¬true⇒false;
rule bool_not_false():¬false⇒true;
rule bool_and_left_true(p:𝔹):true∧p⇒p;
rule bool_and_left_false(p:𝔹):false∧p⇒false;
rule bool_and_right_true(p:𝔹):p∧true⇒p;
rule bool_and_right_false(p:𝔹):p∧false⇒false;
rule bool_or_left_true(p:𝔹):true∨p⇒true;
rule bool_or_left_false(p:𝔹):false∨p⇒p;
rule bool_or_right_true(p:𝔹):p∨true⇒true;
rule bool_or_right_false(p:𝔹):p∨false⇒p;
rule bool_and_same(p:𝔹):p∧p⇒p;
rule bool_or_same(p:𝔹):p∨p⇒p;
rule bool_and_not(p:𝔹):p∧¬p⇒false;
rule bool_not_and(p:𝔹):¬p∧p⇒false;
rule bool_or_not(p:𝔹):p∨¬p⇒true;
rule bool_not_or(p:𝔹):¬p∨p⇒true;
rewrite bool_not_conjunction(p:𝔹,q:𝔹):¬(p∧q)⇒¬p∨¬q;
rewrite bool_not_disjunction(p:𝔹,q:𝔹):¬(p∨q)⇒¬p∧¬q;
rule bool_and_absorb(p:𝔹,q:𝔹):p∧(p∨q)⇒p;
rule bool_or_absorb(p:𝔹,q:𝔹):p∨(p∧q)⇒p;
rewrite bool_and_or(p:𝔹,q:𝔹,r:𝔹):p∧(q∨r)⇒(p∧q)∨(p∧r);
rewrite bool_or_and(p:𝔹,q:𝔹,r:𝔹):(p∨q)∧r⇒(p∧r)∨(q∧r) when defined(q);
rewrite bool_or_prune_left(p:𝔹,q:𝔹):p∨q⇒q when ¬p;
rewrite bool_or_prune_right(p:𝔹,q:𝔹):p∨q⇒p when ¬q;
lemma bool_and_swap(p:𝔹,q:𝔹):p∧q⇒q∧p when defined(q);
lemma bool_or_swap(p:𝔹,q:𝔹):p∨q⇒q∨p when defined(q);
lemma real_le_strict(x:ℝ,y:ℝ):x≤y⇒x<y when x≠y;
rewrite real_lt_self(x:ℝ):x<x⇒false;
rewrite real_le_self(x:ℝ):x≤x⇒true;
rewrite real_not_lt(x:ℝ,y:ℝ):¬(x<y)⇒y≤x;
rewrite real_not_le(x:ℝ,y:ℝ):¬(x≤y)⇒y<x;
rewrite real_lt_shift(x:ℝ,a:ℝ,b:ℝ):x+a<b⇒x<b−a when literal(a),literal(b);
rewrite real_le_shift(x:ℝ,a:ℝ,b:ℝ):x+a≤b⇒x≤b−a when literal(a),literal(b);
rewrite real_lt_right_shift(x:ℝ,a:ℝ,b:ℝ):a<x+b⇒a−b<x when literal(a),literal(b);
rewrite real_le_right_shift(x:ℝ,a:ℝ,b:ℝ):a≤x+b⇒a−b≤x when literal(a),literal(b);
rewrite real_lt_scale_pos(x:ℝ,a:ℝ,b:ℝ):a·x<b⇒x<b/a when 0<a,literal(a),literal(b);
rewrite real_le_scale_pos(x:ℝ,a:ℝ,b:ℝ):a·x≤b⇒x≤b/a when 0<a,literal(a),literal(b);
rewrite real_lt_scale_neg(x:ℝ,a:ℝ,b:ℝ):a·x<b⇒b/a<x when a<0,literal(a),literal(b);
rewrite real_le_scale_neg(x:ℝ,a:ℝ,b:ℝ):a·x≤b⇒b/a≤x when a<0,literal(a),literal(b);
rewrite real_interval_point(x:ℝ):(x≤0∧0≤x)⇒x=0;
rewrite real_interval_puncture(x:ℝ):(x<0∨0<x)⇒x≠0;
rewrite real_interval_closed_point(x:ℝ,a:ℝ):(x≤a∧a≤x)⇒x=a;
rewrite real_interval_open_puncture(x:ℝ,a:ℝ):(x<a∨a<x)⇒x≠a;
rewrite real_interval_cover(x:ℝ,a:ℝ):(x≤a∨a≤x)⇒true;
rewrite real_upper_union(x:ℝ,a:ℝ,b:ℝ):(x<a∨x<b)⇒x<b when a≤b,defined(b);
fact real_nonnegative_square(x:ℝ,n:NatParam):0≤x^(n+n);
fact real_nonnegative_abs(x:ℝ):0≤abs(x);
fact real_nonnegative_add(x:ℝ,y:ℝ):0≤x+y when 0≤x,0≤y;
fact real_positive_add_left(x:ℝ,y:ℝ):0<x+y when 0<x,0≤y;
fact real_positive_add_right(x:ℝ,y:ℝ):0<x+y when 0≤x,0<y;
fact real_positive_nonnegative(x:ℝ):0≤x when 0<x;
fact real_negative_nonpositive(x:ℝ):x≤0 when x<0;
fact real_positive_nonzero(x:ℝ):x≠0 when 0<x;
fact real_negative_nonzero(x:ℝ):x≠0 when x<0;
fact real_positive_inverse(x:ℝ):0<x⁻¹ when 0<x;
fact real_nonnegative_power(x:ℝ,n:NatParam):0≤x^n when 0≤x;
fact real_nonnegative_mul(x:ℝ,y:ℝ):0≤x·y when 0≤x,0≤y;
fact real_nonpositive_mul(x:ℝ,y:ℝ):x·y≤0 when x≤0,0≤y;
fact real_zero_nonnegative(x:ℝ):0≤x when x=0;
fact real_zero_nonpositive(x:ℝ):x≤0 when x=0;
fact real_lt_upper(x:ℝ,a:ℝ,b:ℝ):x<b when x<a,a≤b,defined(a);
fact real_lt_upper_closed(x:ℝ,a:ℝ,b:ℝ):x<b when x≤a,a<b,defined(a);
fact real_le_upper(x:ℝ,a:ℝ,b:ℝ):x≤b when x<a,a≤b,defined(a);
fact real_le_upper_closed(x:ℝ,a:ℝ,b:ℝ):x≤b when x≤a,a≤b,defined(a);
fact real_lt_lower(x:ℝ,a:ℝ,b:ℝ):b<x when a<x,b≤a,defined(a);
fact real_lt_lower_closed(x:ℝ,a:ℝ,b:ℝ):b<x when a≤x,b<a,defined(a);
fact real_le_lower(x:ℝ,a:ℝ,b:ℝ):b≤x when a<x,b≤a,defined(a);
fact real_le_lower_closed(x:ℝ,a:ℝ,b:ℝ):b≤x when a≤x,b≤a,defined(a);
equation real_power_one(x:ℝ):x^1≡x;
equation complex_power_one(x:ℂ):x^1≡x;
lemma bool_false(p:𝔹):p⇒false when ¬p;
rule real_lt_common(x:ℝ,a:ℝ,b:ℝ):x+a<x+b⇒a<b;
rule real_le_common(x:ℝ,a:ℝ,b:ℝ):x+a≤x+b⇒a≤b;

# Native polynomial analysis supplies witnesses; these premises check them.
lemma real_nonzero_scale(p:ℝ,x:ℝ,a:ℝ):p≠0⇒x≠0 when p=a*x,a≠0,defined(a),defined(x);
lemma real_lt_affine_pos(l:ℝ,r:ℝ,a:ℝ,x:ℝ):l<r⇒x<0 when l-r=a*x,0<a,defined(a),defined(x);
lemma real_lt_affine_neg(l:ℝ,r:ℝ,a:ℝ,x:ℝ):l<r⇒0<x when l-r=a*x,a<0,defined(a),defined(x);
lemma real_le_affine_pos(l:ℝ,r:ℝ,a:ℝ,x:ℝ):l≤r⇒x≤0 when l-r=a*x,0<a,defined(a),defined(x);
lemma real_le_affine_neg(l:ℝ,r:ℝ,a:ℝ,x:ℝ):l≤r⇒0≤x when l-r=a*x,a<0,defined(a),defined(x);
lemma real_nonzero_factor(p:ℝ,x:ℝ,y:ℝ):p≠0⇒x≠0∧y≠0 when p=x*y,defined(x),defined(y);
lemma real_lt_factor(l:ℝ,r:ℝ,x:ℝ,y:ℝ):l<r⇒(x<0∧0<y)∨(0<x∧y<0) when l-r=x*y,defined(x),defined(y);
lemma real_le_factor(l:ℝ,r:ℝ,x:ℝ,y:ℝ):l≤r⇒(x≤0∧0≤y)∨(0≤x∧y≤0) when l-r=x*y,defined(x),defined(y);
lemma real_nonzero_definite(p:ℝ,a:ℝ,u:ℝ,v:ℝ):p≠0⇒true when p=a*(u^2+v),a≠0,0<v,defined(a),defined(u),defined(v);
lemma real_lt_definite(l:ℝ,r:ℝ,a:ℝ,u:ℝ,v:ℝ):l<r⇒a<0 when l-r=a*(u^2+v),0<v,defined(a),defined(u),defined(v);
lemma real_le_definite(l:ℝ,r:ℝ,a:ℝ,u:ℝ,v:ℝ):l≤r⇒a≤0 when l-r=a*(u^2+v),0<v,defined(a),defined(u),defined(v);

rule natural_add_zero(x:ℕ):x+0⇒x;
