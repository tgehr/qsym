rewrite complex_exp_log_scale(z:ℂ,w:ℂ):cexp(w*clog(z))⇒powerC(z,w);
rewrite complex_exp_log_scale_right(z:ℂ,w:ℂ):cexp(clog(z)*w)⇒powerC(z,w);
