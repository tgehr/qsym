rewrite real_le_scale_pos(x:ℝ,a:ℝ,b:ℝ):a·x≤b⇒x≤b/a when 0<a,literal(a),literal(b);
rewrite real_lt_scale_neg(x:ℝ,a:ℝ,b:ℝ):a·x<b⇒b/a<x when a<0,literal(a),literal(b);
rewrite real_le_scale_neg(x:ℝ,a:ℝ,b:ℝ):a·x≤b⇒b/a≤x when a<0,literal(a),literal(b);
rewrite real_interval_point(x:ℝ):(x≤0∧0≤x)⇒x=0;
rewrite real_interval_puncture(x:ℝ):(x<0∨0<x)⇒x≠0;
rewrite real_interval_closed_point(x:ℝ,a:ℝ):(x≤a∧a≤x)⇒x=a;
rewrite real_interval_open_puncture(x:ℝ,a:ℝ):(x<a∨a<x)⇒x≠a;
rewrite real_interval_cover(x:ℝ,a:ℝ):(x≤a∨a≤x)⇒true;
rewrite real_upper_union(x:ℝ,a:ℝ,b:ℝ):(x<a∨x<b)⇒x<b when a≤b,defined(b);
