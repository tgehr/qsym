rewrite real_sin_difference(x:ℝ,y:ℝ):sin(x)*cos(y)-cos(x)*sin(y)⇒sin(x-y);
rewrite real_cos_addition(x:ℝ,y:ℝ):cos(x)*cos(y)-sin(x)*sin(y)⇒cos(x+y);
rewrite real_sinh_addition(x:ℝ,y:ℝ):sinh(x)*cosh(y)+cosh(x)*sinh(y)⇒sinh(x+y);
rewrite real_sinh_difference(x:ℝ,y:ℝ):sinh(x)*cosh(y)-cosh(x)*sinh(y)⇒sinh(x-y);
rewrite real_cosh_addition(x:ℝ,y:ℝ):cosh(x)*cosh(y)+sinh(x)*sinh(y)⇒cosh(x+y);
rewrite real_cosh_difference(x:ℝ,y:ℝ):cosh(x)*cosh(y)-sinh(x)*sinh(y)⇒cosh(x-y);
rewrite real_sinh_cosh_product(x:ℝ):sinh(x)*cosh(x)⇒sinh(2*x)/2;
rewrite real_cosh_double(x:ℝ):cosh(x)^2+sinh(x)^2⇒cosh(2*x);
rewrite real_sin_square_complement(x:ℝ):1-sin(x)^2⇒cos(x)^2;
rewrite real_cos_square_complement(x:ℝ):1-cos(x)^2⇒sin(x)^2;
rewrite real_sinh_square_complement(x:ℝ):1+sinh(x)^2⇒cosh(x)^2;
rewrite real_cosh_square_complement(x:ℝ):cosh(x)^2-1⇒sinh(x)^2;
rewrite real_exp_symmetric_sum(x:ℝ):exp(x)+exp(-x)⇒2*cosh(x);
rewrite real_exp_symmetric_difference(x:ℝ):exp(x)-exp(-x)⇒2*sinh(x);
rewrite complex_sin_difference(z:ℂ,w:ℂ):csin(z)*ccos(w)-ccos(z)*csin(w)⇒csin(z-w);
rewrite complex_cos_addition(z:ℂ,w:ℂ):ccos(z)*ccos(w)-csin(z)*csin(w)⇒ccos(z+w);
rewrite complex_sinh_addition(z:ℂ,w:ℂ):csinh(z)*ccosh(w)+ccosh(z)*csinh(w)⇒csinh(z+w);
rewrite complex_sinh_difference(z:ℂ,w:ℂ):csinh(z)*ccosh(w)-ccosh(z)*csinh(w)⇒csinh(z-w);
rewrite complex_cosh_addition(z:ℂ,w:ℂ):ccosh(z)*ccosh(w)+csinh(z)*csinh(w)⇒ccosh(z+w);
rewrite complex_cosh_difference(z:ℂ,w:ℂ):ccosh(z)*ccosh(w)-csinh(z)*csinh(w)⇒ccosh(z-w);
rewrite complex_sinh_cosh_product(z:ℂ):csinh(z)*ccosh(z)⇒csinh(2*z)/2;
rewrite complex_cosh_double(z:ℂ):ccosh(z)^2+csinh(z)^2⇒ccosh(2*z);
rewrite complex_sin_square_complement(z:ℂ):1-csin(z)^2⇒ccos(z)^2;
rewrite complex_cos_square_complement(z:ℂ):1-ccos(z)^2⇒csin(z)^2;
rewrite complex_sinh_square_complement(z:ℂ):1+csinh(z)^2⇒ccosh(z)^2;
rewrite complex_cosh_square_complement(z:ℂ):ccosh(z)^2-1⇒csinh(z)^2;
rewrite complex_exp_symmetric_sum(z:ℂ):cexp(z)+cexp(-z)⇒2*ccosh(z);
rewrite complex_exp_symmetric_difference(z:ℂ):cexp(z)-cexp(-z)⇒2*csinh(z);
rewrite real_cosh_lower(x:ℝ):1≤cosh(x)⇒true;
rewrite real_cosh_positive(x:ℝ):0<cosh(x)⇒true;
rewrite real_cosh_nonzero(x:ℝ):cosh(x)≠0⇒true;
rewrite real_cosh_abs(x:ℝ):abs(cosh(x))⇒cosh(x);
rewrite real_tanh_upper_strict(x:ℝ):tanh(x)<1⇒true;
rewrite real_tanh_lower_strict(x:ℝ):-1<tanh(x)⇒true;
rewrite natural_indexed_one(n:ℕ):powNN(nat(1),n)⇒nat(1);
rewrite integer_indexed_one(n:ℕ):powZN(int(1),n)⇒int(1);
rewrite rational_indexed_one(n:ℕ):powQN(rat(1,1),n)⇒rat(1,1);
rewrite real_indexed_one(n:ℕ):powRN(1,n)⇒1;
rewrite complex_indexed_one(n:ℕ):powCN(complex(1,0),n)⇒complex(1,0);
rewrite rational_indexed_integer_one(k:ℤ):powQZ(rat(1,1),k)⇒rat(1,1);
rewrite rational_parity_even(k:ℤ):powQZ(rat(-1,1),2*k)⇒rat(1,1);
rewrite rational_parity_odd(k:ℤ):powQZ(rat(-1,1),2*k+1)⇒rat(-1,1);
rewrite rational_parity_neg(k:ℤ):powQZ(rat(-1,1),-k)⇒powQZ(rat(-1,1),k);
rewrite rational_parity_square(k:ℤ):powQZ(rat(-1,1),k)^2⇒rat(1,1);
rewrite rational_parity_inverse(k:ℤ):powQZ(rat(-1,1),k)⁻¹⇒powQZ(rat(-1,1),k);
rewrite real_indexed_integer_one(k:ℤ):powRZ(1,k)⇒1;
rewrite real_parity_even(k:ℤ):powRZ(-1,2*k)⇒1;
rewrite real_parity_odd(k:ℤ):powRZ(-1,2*k+1)⇒-1;
rewrite real_parity_neg(k:ℤ):powRZ(-1,-k)⇒powRZ(-1,k);
rewrite real_parity_square(k:ℤ):powRZ(-1,k)^2⇒1;
rewrite real_parity_inverse(k:ℤ):powRZ(-1,k)⁻¹⇒powRZ(-1,k);
rewrite complex_indexed_integer_one(k:ℤ):powCZ(complex(1,0),k)⇒complex(1,0);
rewrite complex_parity_even(k:ℤ):powCZ(complex(-1,0),2*k)⇒complex(1,0);
rewrite complex_parity_odd(k:ℤ):powCZ(complex(-1,0),2*k+1)⇒complex(-1,0);
rewrite complex_parity_neg(k:ℤ):powCZ(complex(-1,0),-k)⇒powCZ(complex(-1,0),k);
rewrite complex_parity_square(k:ℤ):powCZ(complex(-1,0),k)^2⇒complex(1,0);
rewrite complex_parity_inverse(k:ℤ):powCZ(complex(-1,0),k)⁻¹⇒powCZ(complex(-1,0),k);
rewrite real_integer_sin(k:ℤ):sin(toℝ(k)*π)⇒0;
rewrite real_integer_cos(k:ℤ):cos(toℝ(k)*π)⇒powRZ(-1,k);
rewrite real_integer_phase(k:ℤ):cis(toℝ(k)*π)⇒toℂ(powRZ(-1,k));
lemma real_sin_integer_half_turn(x:ℝ,k:ℤ):sin(x)⇒powRZ(-1,k)*sin(x-toℝ(k)*π) when defined(k);
lemma real_cos_integer_half_turn(x:ℝ,k:ℤ):cos(x)⇒powRZ(-1,k)*cos(x-toℝ(k)*π) when defined(k);
lemma phase_integer_half_turn(x:ℝ,k:ℤ):cis(x)⇒toℂ(powRZ(-1,k))*cis(x-toℝ(k)*π) when defined(k);
lemma complex_sin_integer_half_turn(x:ℂ,k:ℤ):csin(x)⇒toℂ(powRZ(-1,k))*csin(x-toℂ(toℝ(k)*π)) when defined(k);
lemma complex_cos_integer_half_turn(x:ℂ,k:ℤ):ccos(x)⇒toℂ(powRZ(-1,k))*ccos(x-toℂ(toℝ(k)*π)) when defined(k);
lemma complex_sin_period(z:ℂ,k:ℤ):csin(z)⇒csin(z-toℂ(toℝ(k)*(2*π))) when defined(k);
lemma complex_cos_period(z:ℂ,k:ℤ):ccos(z)⇒ccos(z-toℂ(toℝ(k)*(2*π))) when defined(k);
lemma complex_tan_period(z:ℂ,k:ℤ):ctan(z)⇒ctan(z-toℂ(toℝ(k)*(1*π))) when defined(k);
lemma complex_sin_quarter_reduce(z:ℂ):csin(z)⇒ccos(z-toℂ(π/2));
lemma complex_cos_quarter_reduce(z:ℂ):ccos(z)⇒-csin(z-toℂ(π/2));
lemma complex_sinh_imaginary_period(z:ℂ,k:ℤ):csinh(z)⇒csinh(z-ⅈ*toℂ(toℝ(k)*(2*π))) when defined(k);
lemma complex_cosh_imaginary_period(z:ℂ,k:ℤ):ccosh(z)⇒ccosh(z-ⅈ*toℂ(toℝ(k)*(2*π))) when defined(k);
lemma complex_tanh_imaginary_period(z:ℂ,k:ℤ):ctanh(z)⇒ctanh(z-ⅈ*toℂ(toℝ(k)*(1*π))) when defined(k);
lemma complex_exp_imaginary_period(z:ℂ,k:ℤ):cexp(z)⇒cexp(z-ⅈ*toℂ(toℝ(k)*(2*π))) when defined(k);
lemma complex_sinh_imaginary_half_turn(z:ℂ,k:ℤ):csinh(z)⇒toℂ(powRZ(-1,k))*csinh(z-ⅈ*toℂ(toℝ(k)*π)) when defined(k);
lemma complex_cosh_imaginary_half_turn(z:ℂ,k:ℤ):ccosh(z)⇒toℂ(powRZ(-1,k))*ccosh(z-ⅈ*toℂ(toℝ(k)*π)) when defined(k);
lemma complex_exp_imaginary_half_turn(z:ℂ,k:ℤ):cexp(z)⇒toℂ(powRZ(-1,k))*cexp(z-ⅈ*toℂ(toℝ(k)*π)) when defined(k);
lemma complex_sinh_imaginary_quarter_reduce(z:ℂ):csinh(z)⇒ⅈ*ccosh(z-ⅈ*toℂ(π/2));
lemma complex_cosh_imaginary_quarter_reduce(z:ℂ):ccosh(z)⇒ⅈ*csinh(z-ⅈ*toℂ(π/2));
lemma complex_exp_imaginary_quarter_reduce(z:ℂ):cexp(z)⇒ⅈ*cexp(z-ⅈ*toℂ(π/2));
rewrite rational_parity_literal_product(k:ℤ,m:ℤ):powQZ(rat(-1,1),k*m)⇒powQZ(powQZ(rat(-1,1),k),m) when literal(k);
rewrite rational_parity_literal_product_left(k:ℤ,m:ℤ,n:ℤ):powQZ(rat(-1,1),(k*m)*n)⇒powQZ(powQZ(rat(-1,1),k),m*n) when literal(k);
rewrite real_parity_literal_product(k:ℤ,m:ℤ):powRZ(-1,k*m)⇒powRZ(powRZ(-1,k),m) when literal(k);
rewrite real_parity_literal_product_left(k:ℤ,m:ℤ,n:ℤ):powRZ(-1,(k*m)*n)⇒powRZ(powRZ(-1,k),m*n) when literal(k);
rewrite complex_parity_literal_product(k:ℤ,m:ℤ):powCZ(complex(-1,0),k*m)⇒powCZ(powCZ(complex(-1,0),k),m) when literal(k);
rewrite complex_parity_literal_product_left(k:ℤ,m:ℤ,n:ℤ):powCZ(complex(-1,0),(k*m)*n)⇒powCZ(powCZ(complex(-1,0),k),m*n) when literal(k);
lemma complex_sin_negative_quarter(z:ℂ):csin(z)⇒-ccos(z+toℂ(real(1,2)*π));
lemma complex_cos_negative_quarter(z:ℂ):ccos(z)⇒csin(z+toℂ(real(1,2)*π));
lemma complex_sinh_negative_quarter(z:ℂ):csinh(z)⇒-ⅈ*ccosh(z+ⅈ*toℂ(real(1,2)*π));
lemma complex_cosh_negative_quarter(z:ℂ):ccosh(z)⇒-ⅈ*csinh(z+ⅈ*toℂ(real(1,2)*π));

# Nested discrete cancellation.
rewrite integer_add_cancel_last(x:ℤ,y:ℤ):(x+y)-y⇒x;
rewrite integer_add_cancel_first(x:ℤ,y:ℤ):(x+y)-x⇒y;
rewrite integer_sub_add_cancel(x:ℤ,y:ℤ):(x-y)+y⇒x;
rewrite integer_add_sub_cancel(x:ℤ,y:ℤ):x+(y-x)⇒y;
rewrite rational_add_cancel_last(x:ℚ,y:ℚ):(x+y)-y⇒x;
rewrite rational_add_cancel_first(x:ℚ,y:ℚ):(x+y)-x⇒y;
rewrite rational_sub_add_cancel(x:ℚ,y:ℚ):(x-y)+y⇒x;
rewrite rational_add_sub_cancel(x:ℚ,y:ℚ):x+(y-x)⇒y;
rewrite rational_cancel_nested_left(x:ℚ,y:ℚ):x*(y*x⁻¹)⇒y;
rewrite rational_cancel_nested_right(x:ℚ,y:ℚ):x*(x⁻¹*y)⇒y;
rewrite rational_cancel_inverse_nested(x:ℚ,y:ℚ):x⁻¹*(x*y)⇒y;
rewrite rational_cancel_inverse_nested_right(x:ℚ,y:ℚ):x⁻¹*(y*x)⇒y;

# Indicator partitions and complementary guards.
rewrite natural_mask_partition(p:𝔹,q:𝔹,x:ℕ):[p]*x+[¬p∧q]*x⇒[p∨q]*x;
rewrite natural_mask_partition_right(p:𝔹,q:𝔹,x:ℕ):[p]*x+[q∧¬p]*x⇒[p∨q]*x;
rewrite natural_mask_or_partition(p:𝔹,q:𝔹,x:ℕ):[p∧q]*x+[¬p∧q]*x⇒[q]*x;
rewrite natural_mask_or_partition_right(p:𝔹,q:𝔹,x:ℕ):[p∧q]*x+[p∧¬q]*x⇒[p]*x;
rewrite natural_mask_union_overlap(p:𝔹,q:𝔹,x:ℕ):[p∨q]*x+[p∧q]*x⇒[p]*x+[q]*x;
rewrite natural_mask_add(p:𝔹,x:ℕ,y:ℕ):[p]*x+[p]*y⇒[p]*(x+y);
rewrite natural_mask_complement(p:𝔹,x:ℕ):[p]*x+[¬p]*x⇒x;
rewrite natural_mask_nested(p:𝔹,q:𝔹,x:ℕ):[p]*([q]*x)⇒[p∧q]*x;
rewrite integer_mask_partition(p:𝔹,q:𝔹,x:ℤ):[p]*x+[¬p∧q]*x⇒[p∨q]*x;
rewrite integer_mask_partition_right(p:𝔹,q:𝔹,x:ℤ):[p]*x+[q∧¬p]*x⇒[p∨q]*x;
rewrite integer_mask_or_partition(p:𝔹,q:𝔹,x:ℤ):[p∧q]*x+[¬p∧q]*x⇒[q]*x;
rewrite integer_mask_or_partition_right(p:𝔹,q:𝔹,x:ℤ):[p∧q]*x+[p∧¬q]*x⇒[p]*x;
rewrite integer_mask_union_overlap(p:𝔹,q:𝔹,x:ℤ):[p∨q]*x+[p∧q]*x⇒[p]*x+[q]*x;
rewrite integer_mask_add(p:𝔹,x:ℤ,y:ℤ):[p]*x+[p]*y⇒[p]*(x+y);
rewrite integer_mask_complement(p:𝔹,x:ℤ):[p]*x+[¬p]*x⇒x;
rewrite integer_mask_nested(p:𝔹,q:𝔹,x:ℤ):[p]*([q]*x)⇒[p∧q]*x;
rewrite rational_mask_partition(p:𝔹,q:𝔹,x:ℚ):[p]*x+[¬p∧q]*x⇒[p∨q]*x;
rewrite rational_mask_partition_right(p:𝔹,q:𝔹,x:ℚ):[p]*x+[q∧¬p]*x⇒[p∨q]*x;
rewrite rational_mask_or_partition(p:𝔹,q:𝔹,x:ℚ):[p∧q]*x+[¬p∧q]*x⇒[q]*x;
rewrite rational_mask_or_partition_right(p:𝔹,q:𝔹,x:ℚ):[p∧q]*x+[p∧¬q]*x⇒[p]*x;
rewrite rational_mask_union_overlap(p:𝔹,q:𝔹,x:ℚ):[p∨q]*x+[p∧q]*x⇒[p]*x+[q]*x;
rewrite rational_mask_add(p:𝔹,x:ℚ,y:ℚ):[p]*x+[p]*y⇒[p]*(x+y);
rewrite rational_mask_complement(p:𝔹,x:ℚ):[p]*x+[¬p]*x⇒x;
rewrite rational_mask_nested(p:𝔹,q:𝔹,x:ℚ):[p]*([q]*x)⇒[p∧q]*x;
rewrite real_mask_partition(p:𝔹,q:𝔹,x:ℝ):[p]*x+[¬p∧q]*x⇒[p∨q]*x;
rewrite real_mask_partition_right(p:𝔹,q:𝔹,x:ℝ):[p]*x+[q∧¬p]*x⇒[p∨q]*x;
rewrite real_mask_or_partition(p:𝔹,q:𝔹,x:ℝ):[p∧q]*x+[¬p∧q]*x⇒[q]*x;
rewrite real_mask_or_partition_right(p:𝔹,q:𝔹,x:ℝ):[p∧q]*x+[p∧¬q]*x⇒[p]*x;
rewrite real_mask_union_overlap(p:𝔹,q:𝔹,x:ℝ):[p∨q]*x+[p∧q]*x⇒[p]*x+[q]*x;
rewrite complex_mask_partition(p:𝔹,q:𝔹,x:ℂ):[p]*x+[¬p∧q]*x⇒[p∨q]*x;
rewrite complex_mask_partition_right(p:𝔹,q:𝔹,x:ℂ):[p]*x+[q∧¬p]*x⇒[p∨q]*x;
rewrite complex_mask_or_partition(p:𝔹,q:𝔹,x:ℂ):[p∧q]*x+[¬p∧q]*x⇒[q]*x;
rewrite complex_mask_or_partition_right(p:𝔹,q:𝔹,x:ℂ):[p∧q]*x+[p∧¬q]*x⇒[p]*x;
rewrite complex_mask_union_overlap(p:𝔹,q:𝔹,x:ℂ):[p∨q]*x+[p∧q]*x⇒[p]*x+[q]*x;

# Complement may already have been normalized before the partition matches.
rewrite natural_mask_partition_not(p:𝔹,q:𝔹,x:ℕ):[¬p]*x+[p∧q]*x⇒[¬p∨q]*x;
rewrite natural_mask_partition_not_right(p:𝔹,q:𝔹,x:ℕ):[¬p]*x+[q∧p]*x⇒[¬p∨q]*x;
rewrite integer_mask_partition_not(p:𝔹,q:𝔹,x:ℤ):[¬p]*x+[p∧q]*x⇒[¬p∨q]*x;
rewrite integer_mask_partition_not_right(p:𝔹,q:𝔹,x:ℤ):[¬p]*x+[q∧p]*x⇒[¬p∨q]*x;
rewrite rational_mask_partition_not(p:𝔹,q:𝔹,x:ℚ):[¬p]*x+[p∧q]*x⇒[¬p∨q]*x;
rewrite rational_mask_partition_not_right(p:𝔹,q:𝔹,x:ℚ):[¬p]*x+[q∧p]*x⇒[¬p∨q]*x;
rewrite real_mask_partition_not(p:𝔹,q:𝔹,x:ℝ):[¬p]*x+[p∧q]*x⇒[¬p∨q]*x;
rewrite real_mask_partition_not_right(p:𝔹,q:𝔹,x:ℝ):[¬p]*x+[q∧p]*x⇒[¬p∨q]*x;
rewrite complex_mask_partition_not(p:𝔹,q:𝔹,x:ℂ):[¬p]*x+[p∧q]*x⇒[¬p∨q]*x;
rewrite complex_mask_partition_not_right(p:𝔹,q:𝔹,x:ℂ):[¬p]*x+[q∧p]*x⇒[¬p∨q]*x;

# Unit values of general powers, including even and odd negative-base cases.
rewrite real_noninteger_power_unit(x:ℝ,t:ℝ):powerR(x,t)=1⇒x=1 when ¬inZ(t);
rewrite real_minus_one_power_unit(t:ℝ):powerR(-1,t)=1⇒inZ(t/2);
rewrite complex_minus_one_power_unit(w:ℂ):powerC(-1,w)=1⇒inZ(creal(w)/2) when cimag(w)=0;
rewrite real_power_eq_one(x:ℝ,t:ℝ):powerR(x,t)=1⇒t=0∨x=1∨(x=-1∧inZ(t/2));
rewrite real_power_ne_one(x:ℝ,t:ℝ):powerR(x,t)≠1⇒¬(t=0∨x=1∨(x=-1∧inZ(t/2)));
rewrite real_power_eq_neg_one(x:ℝ,t:ℝ):powerR(x,t)=-1⇒x=-1∧inZ((t-1)/2);
rewrite real_power_ne_neg_one(x:ℝ,t:ℝ):powerR(x,t)≠-1⇒¬(x=-1∧inZ((t-1)/2));
rewrite complex_real_power_eq_one(z:ℂ,w:ℂ):powerC(z,w)=1⇒creal(w)=0∨z=1∨(z=-1∧inZ(creal(w)/2)) when cimag(z)=0,cimag(w)=0;
rewrite complex_real_power_ne_one(z:ℂ,w:ℂ):powerC(z,w)≠1⇒¬(creal(w)=0∨z=1∨(z=-1∧inZ(creal(w)/2))) when cimag(z)=0,cimag(w)=0;
rewrite complex_nonnegative_power(z:ℂ,w:ℂ):powerC(z,w)⇒toℂ(powerR(creal(z),creal(w))) when cimag(z)=0,cimag(w)=0,0≤creal(z);
rewrite complex_power_nonzero_cases(z:ℂ,w:ℂ):powerC(z,w)≠0⇒z≠0∨w=0;
rewrite natural_mask_mul_left(p:𝔹,x:ℕ,y:ℕ):mulN(maskN(p,x),y)⇒[p]*(x*y);
rewrite natural_mask_mul_right(p:𝔹,x:ℕ,y:ℕ):mulN(x,maskN(p,y))⇒[p]*(x*y);
rewrite integer_mask_mul_left(p:𝔹,x:ℤ,y:ℤ):mulZ(maskZ(p,x),y)⇒[p]*(x*y);
rewrite integer_mask_mul_right(p:𝔹,x:ℤ,y:ℤ):mulZ(x,maskZ(p,y))⇒[p]*(x*y);
rewrite rational_mask_mul_left(p:𝔹,x:ℚ,y:ℚ):mulQ(maskQ(p,x),y)⇒[p]*(x*y);
rewrite rational_mask_mul_right(p:𝔹,x:ℚ,y:ℚ):mulQ(x,maskQ(p,y))⇒[p]*(x*y);

# Retraction of exact scalar embeddings; selected by the native cast pass.
lemma embed_NZ_add(x:ℕ,y:ℕ):castNZ(x)+castNZ(y)⇒castNZ(x+y);
lemma embed_NZ_mul(x:ℕ,y:ℕ):castNZ(x)*castNZ(y)⇒castNZ(x*y);
lemma embed_NZ_pow(x:ℕ,n:NatParam):castNZ(x)^n⇒castNZ(x^n);
lemma embed_NZ_mask(p:𝔹,x:ℕ):[p]*castNZ(x)⇒castNZ([p]*x);
lemma embed_NZ_nonzero(x:ℕ):nonzeroZ(castNZ(x))⇒nonzeroN(x);
lemma embed_NZ_lt(x:ℕ,y:ℕ):castNZ(x)<castNZ(y)⇒x<y;
lemma embed_NZ_le(x:ℕ,y:ℕ):castNZ(x)≤castNZ(y)⇒x≤y;
lemma embed_ZQ_add(x:ℤ,y:ℤ):castZQ(x)+castZQ(y)⇒castZQ(x+y);
lemma embed_ZQ_mul(x:ℤ,y:ℤ):castZQ(x)*castZQ(y)⇒castZQ(x*y);
lemma embed_ZQ_pow(x:ℤ,n:NatParam):castZQ(x)^n⇒castZQ(x^n);
lemma embed_ZQ_mask(p:𝔹,x:ℤ):[p]*castZQ(x)⇒castZQ([p]*x);
lemma embed_ZQ_nonzero(x:ℤ):nonzeroQ(castZQ(x))⇒nonzeroZ(x);
lemma embed_ZQ_lt(x:ℤ,y:ℤ):castZQ(x)<castZQ(y)⇒x<y;
lemma embed_ZQ_le(x:ℤ,y:ℤ):castZQ(x)≤castZQ(y)⇒x≤y;
lemma embed_QR_add(x:ℚ,y:ℚ):castQR(x)+castQR(y)⇒castQR(x+y);
lemma embed_QR_mul(x:ℚ,y:ℚ):castQR(x)*castQR(y)⇒castQR(x*y);
lemma embed_QR_pow(x:ℚ,n:NatParam):castQR(x)^n⇒castQR(x^n);
lemma embed_QR_mask(p:𝔹,x:ℚ):[p]*castQR(x)⇒castQR([p]*x);
lemma embed_QR_nonzero(x:ℚ):nonzeroR(castQR(x))⇒nonzeroQ(x);
lemma embed_QR_lt(x:ℚ,y:ℚ):castQR(x)<castQR(y)⇒x<y;
lemma embed_QR_le(x:ℚ,y:ℚ):castQR(x)≤castQR(y)⇒x≤y;
lemma embed_QR_inv(x:ℚ):castQR(x)⁻¹⇒castQR(x⁻¹);
lemma embed_RC_add(x:ℝ,y:ℝ):castRC(x)+castRC(y)⇒castRC(x+y);
lemma embed_RC_mul(x:ℝ,y:ℝ):castRC(x)*castRC(y)⇒castRC(x*y);
lemma embed_RC_pow(x:ℝ,n:NatParam):castRC(x)^n⇒castRC(x^n);
lemma embed_RC_mask(p:𝔹,x:ℝ):[p]*castRC(x)⇒castRC([p]*x);
lemma embed_RC_nonzero(x:ℝ):nonzeroC(castRC(x))⇒nonzeroR(x);
lemma embed_RC_inv(x:ℝ):castRC(x)⁻¹⇒castRC(x⁻¹);

# Unit values of powers with natural and integer exponents.
rewrite indexed_ZN_eq_one(x:ℤ,n:ℕ):powZN(x,n)=1⇒n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1);
rewrite indexed_ZN_ne_one(x:ℤ,n:ℕ):powZN(x,n)≠1⇒¬(n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1));
rewrite indexed_ZN_eq_neg_one(x:ℤ,n:ℕ):powZN(x,n)=-1⇒x=-1∧denominator((toℚ(n)-1)/2)=1;
rewrite indexed_ZN_ne_neg_one(x:ℤ,n:ℕ):powZN(x,n)≠-1⇒¬(x=-1∧denominator((toℚ(n)-1)/2)=1);
rewrite indexed_QN_eq_one(x:ℚ,n:ℕ):powQN(x,n)=1⇒n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1);
rewrite indexed_QN_ne_one(x:ℚ,n:ℕ):powQN(x,n)≠1⇒¬(n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1));
rewrite indexed_QN_eq_neg_one(x:ℚ,n:ℕ):powQN(x,n)=-1⇒x=-1∧denominator((toℚ(n)-1)/2)=1;
rewrite indexed_QN_ne_neg_one(x:ℚ,n:ℕ):powQN(x,n)≠-1⇒¬(x=-1∧denominator((toℚ(n)-1)/2)=1);
rewrite indexed_RN_eq_one(x:ℝ,n:ℕ):powRN(x,n)=1⇒n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1);
rewrite indexed_RN_ne_one(x:ℝ,n:ℕ):powRN(x,n)≠1⇒¬(n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1));
rewrite indexed_RN_eq_neg_one(x:ℝ,n:ℕ):powRN(x,n)=-1⇒x=-1∧denominator((toℚ(n)-1)/2)=1;
rewrite indexed_RN_ne_neg_one(x:ℝ,n:ℕ):powRN(x,n)≠-1⇒¬(x=-1∧denominator((toℚ(n)-1)/2)=1);
rewrite indexed_QZ_eq_one(x:ℚ,n:ℤ):powQZ(x,n)=1⇒n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1);
rewrite indexed_QZ_ne_one(x:ℚ,n:ℤ):powQZ(x,n)≠1⇒¬(n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1));
rewrite indexed_QZ_eq_neg_one(x:ℚ,n:ℤ):powQZ(x,n)=-1⇒x=-1∧denominator((toℚ(n)-1)/2)=1;
rewrite indexed_QZ_ne_neg_one(x:ℚ,n:ℤ):powQZ(x,n)≠-1⇒¬(x=-1∧denominator((toℚ(n)-1)/2)=1);
rewrite indexed_RZ_eq_one(x:ℝ,n:ℤ):powRZ(x,n)=1⇒n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1);
rewrite indexed_RZ_ne_one(x:ℝ,n:ℤ):powRZ(x,n)≠1⇒¬(n=0∨x=1∨(x=-1∧denominator(toℚ(n)/2)=1));
rewrite indexed_RZ_eq_neg_one(x:ℝ,n:ℤ):powRZ(x,n)=-1⇒x=-1∧denominator((toℚ(n)-1)/2)=1;
rewrite indexed_RZ_ne_neg_one(x:ℝ,n:ℤ):powRZ(x,n)≠-1⇒¬(x=-1∧denominator((toℚ(n)-1)/2)=1);
rewrite indexed_CN_eq_one(z:ℂ,n:ℕ):powCN(z,n)=1⇒n=0∨z=1∨(z=-1∧denominator(toℚ(n)/2)=1) when cimag(z)=0;
rewrite indexed_CN_ne_one(z:ℂ,n:ℕ):powCN(z,n)≠1⇒¬(n=0∨z=1∨(z=-1∧denominator(toℚ(n)/2)=1)) when cimag(z)=0;
rewrite indexed_CZ_eq_one(z:ℂ,n:ℤ):powCZ(z,n)=1⇒n=0∨z=1∨(z=-1∧denominator(toℚ(n)/2)=1) when cimag(z)=0;
rewrite indexed_CZ_ne_one(z:ℂ,n:ℤ):powCZ(z,n)≠1⇒¬(n=0∨z=1∨(z=-1∧denominator(toℚ(n)/2)=1)) when cimag(z)=0;

# Canonical placement of literal coefficients in the discrete scalar types.
rewrite natural_literal_coefficient(x:ℕ,c:ℕ):x*c⇒c*x when literal(c);
rewrite natural_literal_constant(x:ℕ,c:ℕ):c+x⇒x+c when literal(c);
rewrite integer_literal_coefficient(x:ℤ,c:ℤ):x*c⇒c*x when literal(c);
rewrite integer_literal_constant(x:ℤ,c:ℤ):c+x⇒x+c when literal(c);
rewrite rational_literal_coefficient(x:ℚ,c:ℚ):x*c⇒c*x when literal(c);
rewrite rational_literal_constant(x:ℚ,c:ℚ):c+x⇒x+c when literal(c);

rewrite real_tanh_asinh(x:ℝ):tanh(asinh(x))⇒x/sqrt(1+x^2);
rewrite real_tanh_acosh(x:ℝ):tanh(acosh(x))⇒sqrt(x^2-1)/x;
rewrite complex_tanh_asinh(z:ℂ):ctanh(casinh(z))⇒z/csqrt(z^2+1);
rewrite complex_tanh_acosh(z:ℂ):ctanh(cacosh(z))⇒csqrt(z-1)*csqrt(z+1)/z;

# Discrete order, exact bounds, extrema, and signs.
rewrite natural_not_lt(x:ℕ,y:ℕ):¬(x<y)⇒y≤x;
rewrite natural_not_le(x:ℕ,y:ℕ):¬(x≤y)⇒y<x;
rewrite natural_lt_cancel_right(x:ℕ,y:ℕ,t:ℕ):x+t<y+t⇒x<y;
rewrite natural_lt_cancel_cross(x:ℕ,y:ℕ,t:ℕ):x+t<t+y⇒x<y;
rewrite natural_lt_cancel_cross_right(x:ℕ,y:ℕ,t:ℕ):t+x<y+t⇒x<y;
rewrite natural_lt_cancel_positive(x:ℕ,y:ℕ,t:ℕ):t*x<t*y⇒x<y when 0<t;
rewrite natural_le_cancel_right(x:ℕ,y:ℕ,t:ℕ):x+t≤y+t⇒x≤y;
rewrite natural_le_cancel_cross(x:ℕ,y:ℕ,t:ℕ):x+t≤t+y⇒x≤y;
rewrite natural_le_cancel_cross_right(x:ℕ,y:ℕ,t:ℕ):t+x≤y+t⇒x≤y;
rewrite natural_le_cancel_positive(x:ℕ,y:ℕ,t:ℕ):t*x≤t*y⇒x≤y when 0<t;
rewrite integer_not_lt(x:ℤ,y:ℤ):¬(x<y)⇒y≤x;
rewrite integer_not_le(x:ℤ,y:ℤ):¬(x≤y)⇒y<x;
rewrite integer_lt_cancel_right(x:ℤ,y:ℤ,t:ℤ):x+t<y+t⇒x<y;
rewrite integer_lt_cancel_cross(x:ℤ,y:ℤ,t:ℤ):x+t<t+y⇒x<y;
rewrite integer_lt_cancel_cross_right(x:ℤ,y:ℤ,t:ℤ):t+x<y+t⇒x<y;
rewrite integer_lt_cancel_positive(x:ℤ,y:ℤ,t:ℤ):t*x<t*y⇒x<y when 0<t;
rewrite integer_lt_cancel_negative(x:ℤ,y:ℤ,t:ℤ):t*x<t*y⇒y<x when t<0;
rewrite integer_le_cancel_right(x:ℤ,y:ℤ,t:ℤ):x+t≤y+t⇒x≤y;
rewrite integer_le_cancel_cross(x:ℤ,y:ℤ,t:ℤ):x+t≤t+y⇒x≤y;
rewrite integer_le_cancel_cross_right(x:ℤ,y:ℤ,t:ℤ):t+x≤y+t⇒x≤y;
rewrite integer_le_cancel_positive(x:ℤ,y:ℤ,t:ℤ):t*x≤t*y⇒x≤y when 0<t;
rewrite integer_le_cancel_negative(x:ℤ,y:ℤ,t:ℤ):t*x≤t*y⇒y≤x when t<0;
rewrite rational_not_lt(x:ℚ,y:ℚ):¬(x<y)⇒y≤x;
rewrite rational_not_le(x:ℚ,y:ℚ):¬(x≤y)⇒y<x;
rewrite rational_lt_cancel_right(x:ℚ,y:ℚ,t:ℚ):x+t<y+t⇒x<y;
rewrite rational_lt_cancel_cross(x:ℚ,y:ℚ,t:ℚ):x+t<t+y⇒x<y;
rewrite rational_lt_cancel_cross_right(x:ℚ,y:ℚ,t:ℚ):t+x<y+t⇒x<y;
rewrite rational_lt_cancel_positive(x:ℚ,y:ℚ,t:ℚ):t*x<t*y⇒x<y when 0<t;
rewrite rational_lt_cancel_negative(x:ℚ,y:ℚ,t:ℚ):t*x<t*y⇒y<x when t<0;
rewrite rational_le_cancel_right(x:ℚ,y:ℚ,t:ℚ):x+t≤y+t⇒x≤y;
rewrite rational_le_cancel_cross(x:ℚ,y:ℚ,t:ℚ):x+t≤t+y⇒x≤y;
rewrite rational_le_cancel_cross_right(x:ℚ,y:ℚ,t:ℚ):t+x≤y+t⇒x≤y;
rewrite rational_le_cancel_positive(x:ℚ,y:ℚ,t:ℚ):t*x≤t*y⇒x≤y when 0<t;
rewrite rational_le_cancel_negative(x:ℚ,y:ℚ,t:ℚ):t*x≤t*y⇒y≤x when t<0;
rewrite integer_lt_shift(x:ℤ,a:ℤ,b:ℤ):x+a<b⇒x<b-a when literal(a),literal(b);
rewrite integer_lt_shift_right(x:ℤ,a:ℤ,b:ℤ):a<x+b⇒a-b<x when literal(a),literal(b);
rewrite integer_le_shift(x:ℤ,a:ℤ,b:ℤ):x+a≤b⇒x≤b-a when literal(a),literal(b);
rewrite integer_le_shift_right(x:ℤ,a:ℤ,b:ℤ):a≤x+b⇒a-b≤x when literal(a),literal(b);
rewrite rational_lt_shift(x:ℚ,a:ℚ,b:ℚ):x+a<b⇒x<b-a when literal(a),literal(b);
rewrite rational_lt_shift_right(x:ℚ,a:ℚ,b:ℚ):a<x+b⇒a-b<x when literal(a),literal(b);
rewrite rational_le_shift(x:ℚ,a:ℚ,b:ℚ):x+a≤b⇒x≤b-a when literal(a),literal(b);
rewrite rational_le_shift_right(x:ℚ,a:ℚ,b:ℚ):a≤x+b⇒a-b≤x when literal(a),literal(b);
rewrite rational_lt_scale_positive(x:ℚ,a:ℚ,b:ℚ):a*x<b⇒x<b/a when 0<a,literal(a),literal(b);
rewrite rational_lt_scale_negative(x:ℚ,a:ℚ,b:ℚ):a*x<b⇒b/a<x when a<0,literal(a),literal(b);
rewrite rational_le_scale_positive(x:ℚ,a:ℚ,b:ℚ):a*x≤b⇒x≤b/a when 0<a,literal(a),literal(b);
rewrite rational_le_scale_negative(x:ℚ,a:ℚ,b:ℚ):a*x≤b⇒b/a≤x when a<0,literal(a),literal(b);
rewrite natural_lt_successor(x:ℕ,y:ℕ):x<y+1⇒x≤y;
rewrite natural_successor_le(x:ℕ,y:ℕ):x+1≤y⇒x<y;
rewrite integer_lt_successor(x:ℤ,y:ℤ):x<y+1⇒x≤y;
rewrite integer_successor_le(x:ℤ,y:ℤ):x+1≤y⇒x<y;
rewrite natural_never_negative(x:ℕ):x<0⇒false;
rewrite natural_nonpositive_zero(x:ℕ):x≤0⇒x=0;
rewrite natural_positive_nonzero(x:ℕ):0<x⇒x≠0;
rewrite natural_nonzero_sum(x:ℕ,y:ℕ):x+y≠0⇒x≠0∨y≠0;
rewrite rational_inverse_negative(x:ℚ):x⁻¹<0⇒x<0;
rewrite rational_inverse_positive(x:ℚ):0<x⁻¹⇒0<x;
rewrite rational_inverse_nonnegative(x:ℚ):0≤x⁻¹⇒0≤x;
rewrite rational_inverse_nonpositive(x:ℚ):x⁻¹≤0⇒x≤0;
rewrite rational_inverse_ne(x:ℚ,y:ℚ):x⁻¹≠y⁻¹⇒x≠y;
rewrite rational_nonnegative_inverse_lt(x:ℚ,y:ℚ):x⁻¹<y⁻¹⇒y<x when 0≤x,0≤y;
rewrite rational_nonnegative_inverse_le(x:ℚ,y:ℚ):x⁻¹≤y⁻¹⇒y≤x when 0≤x,0≤y;
rewrite rational_nonpositive_inverse_lt(x:ℚ,y:ℚ):x⁻¹<y⁻¹⇒y<x when x≤0,y≤0;
rewrite rational_nonpositive_inverse_le(x:ℚ,y:ℚ):x⁻¹≤y⁻¹⇒y≤x when x≤0,y≤0;
lemma integer_rational_bound_lt(k:ℤ,q:ℚ,n:ℤ):toℚ(k)<q⇒k<n when n=ceil(q),defined(n);
lemma integer_rational_bound_le(k:ℤ,q:ℚ,n:ℤ):toℚ(k)≤q⇒k≤n when n=floor(q),defined(n);
lemma integer_rational_bound_lt_right(k:ℤ,q:ℚ,n:ℤ):q<toℚ(k)⇒n<k when n=floor(q),defined(n);
lemma integer_rational_bound_le_right(k:ℤ,q:ℚ,n:ℤ):q≤toℚ(k)⇒n≤k when n=ceil(q),defined(n);
rewrite real_min_neg(x:ℝ,y:ℝ):min(-x,-y)⇒-max(x,y);
rewrite real_min_opposite(x:ℝ):min(x,-x)⇒-abs(x);
rewrite real_min_translate(x:ℝ,y:ℝ,t:ℝ):min(x+t,y+t)⇒min(x,y)+t;
rewrite real_min_positive_scale(x:ℝ,y:ℝ,t:ℝ):min(t*x,t*y)⇒t*min(x,y) when 0<t;
rewrite real_min_negative_scale(x:ℝ,y:ℝ,t:ℝ):min(t*x,t*y)⇒t*max(x,y) when t<0;
rewrite real_min_exp(x:ℝ,y:ℝ):min(exp(x),exp(y))⇒exp(min(x,y));
rewrite real_min_log(x:ℝ,y:ℝ):min(log(x),log(y))⇒log(min(x,y));
rewrite real_min_sqrt(x:ℝ,y:ℝ):min(sqrt(x),sqrt(y))⇒sqrt(min(x,y));
rewrite real_min_sinh(x:ℝ,y:ℝ):min(sinh(x),sinh(y))⇒sinh(min(x,y));
rewrite real_min_asinh(x:ℝ,y:ℝ):min(asinh(x),asinh(y))⇒asinh(min(x,y));
rewrite real_min_tanh(x:ℝ,y:ℝ):min(tanh(x),tanh(y))⇒tanh(min(x,y));
rewrite real_min_atan(x:ℝ,y:ℝ):min(atan(x),atan(y))⇒atan(min(x,y));
rewrite real_min_asin(x:ℝ,y:ℝ):min(asin(x),asin(y))⇒asin(min(x,y));
rewrite real_min_cbrt(x:ℝ,y:ℝ):min(cbrt(x),cbrt(y))⇒cbrt(min(x,y));
rewrite real_min_acosh(x:ℝ,y:ℝ):min(acosh(x),acosh(y))⇒acosh(min(x,y));
rewrite real_min_atanh(x:ℝ,y:ℝ):min(atanh(x),atanh(y))⇒atanh(min(x,y));
rewrite real_min_erf(x:ℝ,y:ℝ):min(erf(x),erf(y))⇒erf(min(x,y));
rewrite real_min_acos(x:ℝ,y:ℝ):min(acos(x),acos(y))⇒acos(max(x,y));
rewrite real_min_erfc(x:ℝ,y:ℝ):min(erfc(x),erfc(y))⇒erfc(max(x,y));
rewrite real_max_neg(x:ℝ,y:ℝ):max(-x,-y)⇒-min(x,y);
rewrite real_max_opposite(x:ℝ):max(x,-x)⇒abs(x);
rewrite real_max_translate(x:ℝ,y:ℝ,t:ℝ):max(x+t,y+t)⇒max(x,y)+t;
rewrite real_max_positive_scale(x:ℝ,y:ℝ,t:ℝ):max(t*x,t*y)⇒t*max(x,y) when 0<t;
rewrite real_max_negative_scale(x:ℝ,y:ℝ,t:ℝ):max(t*x,t*y)⇒t*min(x,y) when t<0;
rewrite real_max_exp(x:ℝ,y:ℝ):max(exp(x),exp(y))⇒exp(max(x,y));
rewrite real_max_log(x:ℝ,y:ℝ):max(log(x),log(y))⇒log(max(x,y));
rewrite real_max_sqrt(x:ℝ,y:ℝ):max(sqrt(x),sqrt(y))⇒sqrt(max(x,y));
rewrite real_max_sinh(x:ℝ,y:ℝ):max(sinh(x),sinh(y))⇒sinh(max(x,y));
rewrite real_max_asinh(x:ℝ,y:ℝ):max(asinh(x),asinh(y))⇒asinh(max(x,y));
rewrite real_max_tanh(x:ℝ,y:ℝ):max(tanh(x),tanh(y))⇒tanh(max(x,y));
rewrite real_max_atan(x:ℝ,y:ℝ):max(atan(x),atan(y))⇒atan(max(x,y));
rewrite real_max_asin(x:ℝ,y:ℝ):max(asin(x),asin(y))⇒asin(max(x,y));
rewrite real_max_cbrt(x:ℝ,y:ℝ):max(cbrt(x),cbrt(y))⇒cbrt(max(x,y));
rewrite real_max_acosh(x:ℝ,y:ℝ):max(acosh(x),acosh(y))⇒acosh(max(x,y));
rewrite real_max_atanh(x:ℝ,y:ℝ):max(atanh(x),atanh(y))⇒atanh(max(x,y));
rewrite real_max_erf(x:ℝ,y:ℝ):max(erf(x),erf(y))⇒erf(max(x,y));
rewrite real_max_acos(x:ℝ,y:ℝ):max(acos(x),acos(y))⇒acos(min(x,y));
rewrite real_max_erfc(x:ℝ,y:ℝ):max(erfc(x),erfc(y))⇒erfc(min(x,y));
rewrite real_sign_neg(x:ℝ):sign(-x)⇒-sign(x);
rewrite real_sign_product(x:ℝ,y:ℝ):sign(x*y)⇒sign(x)*sign(y);
rewrite real_sign_inverse(x:ℝ):sign(x⁻¹)⇒sign(x);
rewrite real_sign_abs(x:ℝ):sign(abs(x))⇒sign(x)^2;
rewrite real_sign_idempotent(x:ℝ):sign(toℝ(sign(x)))⇒sign(x);
rewrite real_sign_nonzero(x:ℝ):sign(x)≠0⇒x≠0;
rewrite real_sign_lt_zero(x:ℝ):sign(x)<0⇒x<0;
rewrite real_sign_le_zero(x:ℝ):sign(x)≤0⇒x≤0;
rewrite real_sign_positive_test(x:ℝ):0<sign(x)⇒0<x;
rewrite real_sign_nonnegative_test(x:ℝ):0≤sign(x)⇒0≤x;
rewrite real_sign_times_self(x:ℝ):toℝ(sign(x))*x⇒abs(x);
rewrite real_sign_times_abs(x:ℝ):toℝ(sign(x))*abs(x)⇒x;

# Natural embeddings retain their lower bound when compared with integers.
rewrite natural_integer_lower_strict(n:ℕ,k:ℤ):k<toℤ(n)⇒true when k<0;
rewrite natural_integer_lower_weak(n:ℕ,k:ℤ):k≤toℤ(n)⇒true when k≤0;
rewrite natural_integer_upper_strict(n:ℕ,k:ℤ):toℤ(n)<k⇒false when k≤0;
rewrite natural_integer_upper_weak(n:ℕ,k:ℤ):toℤ(n)≤k⇒false when k<0;

# Discrete algebra and elementary-function compositions.
rewrite natural_collect_nested(x:ℕ,y:ℕ):x+(y+x)⇒2*x+y;
rewrite integer_collect_nested(x:ℤ,y:ℤ):x+(y+x)⇒2*x+y;
rewrite rational_collect_nested(x:ℚ,y:ℚ):x+(y+x)⇒2*x+y;
rewrite integer_cancel_commuted_sum(x:ℤ,y:ℤ):(x+y)-(y+x)⇒0;
rewrite integer_cancel_opposite_difference(x:ℤ,y:ℤ):(x-y)+(y-x)⇒0;
rewrite rational_cancel_commuted_sum(x:ℚ,y:ℚ):(x+y)-(y+x)⇒0;
rewrite rational_cancel_opposite_difference(x:ℚ,y:ℚ):(x-y)+(y-x)⇒0;

rewrite rational_cancel_denominator_left(x:ℚ,y:ℚ):x*(x*y)⁻¹⇒y⁻¹;
rewrite rational_cancel_denominator_right(x:ℚ,y:ℚ):x*(y*x)⁻¹⇒y⁻¹;
rewrite rational_commuted_product_quotient(x:ℚ,y:ℚ):(x*y)*(y*x)⁻¹⇒1;
rewrite rational_reciprocal_quotients(x:ℚ,y:ℚ):(x*y⁻¹)*(y*x⁻¹)⇒1;

rewrite real_exp_asinh(x:ℝ):exp(asinh(x))⇒x+sqrt(1+x^2);
rewrite real_exp_acosh(x:ℝ):exp(acosh(x))⇒x+sqrt(x^2-1);
rewrite complex_exp_asinh(z:ℂ):cexp(casinh(z))⇒z+csqrt(z^2+1);
rewrite complex_exp_acosh(z:ℂ):cexp(cacosh(z))⇒z+csqrt(z-1)*csqrt(z+1);
rewrite real_cosh_atanh(x:ℝ):cosh(atanh(x))⇒1/sqrt(1-x^2);
rewrite real_sinh_atanh(x:ℝ):sinh(atanh(x))⇒x/sqrt(1-x^2);

rewrite integer_neg_even_power(x:ℤ,n:NatParam):(-x)^(2*n)⇒x^(2*n);
rewrite integer_neg_odd_power(x:ℤ,n:NatParam):(-x)^(2*n+1)⇒-(x^(2*n+1));
rewrite rational_neg_even_power(x:ℚ,n:NatParam):(-x)^(2*n)⇒x^(2*n);
rewrite rational_neg_odd_power(x:ℚ,n:NatParam):(-x)^(2*n+1)⇒-(x^(2*n+1));
rewrite natural_pow_product(x:ℕ,y:ℕ,n:NatParam):(x*y)^n⇒x^n*y^n;
rewrite integer_pow_product(x:ℤ,y:ℤ,n:NatParam):(x*y)^n⇒x^n*y^n;
rewrite rational_pow_product(x:ℚ,y:ℚ,n:NatParam):(x*y)^n⇒x^n*y^n;
rewrite rational_inverse_power(x:ℚ,n:NatParam):(x^(n+1))⁻¹⇒(x⁻¹)^(n+1);
rewrite rational_inverse_product(x:ℚ,y:ℚ):(x*y)⁻¹⇒x⁻¹*y⁻¹;
rewrite rational_power_div_base(x:ℚ,n:NatParam):x^(n+1)*x⁻¹⇒x^n;
rewrite rational_base_div_power(x:ℚ,n:NatParam):x*(x^(n+1))⁻¹⇒(x⁻¹)^n;

rewrite real_sinh_log(x:ℝ):sinh(log(x))⇒(x-x⁻¹)/2;
rewrite real_cosh_log(x:ℝ):cosh(log(x))⇒(x+x⁻¹)/2;
rewrite real_tanh_log(x:ℝ):tanh(log(x))⇒(x^2-1)/(x^2+1);
rewrite complex_sinh_log(x:ℂ):csinh(clog(x))⇒(x-x⁻¹)/2;
rewrite complex_cosh_log(x:ℂ):ccosh(clog(x))⇒(x+x⁻¹)/2;
rewrite complex_tanh_log(x:ℂ):ctanh(clog(x))⇒(x^2-1)/(x^2+1);

rewrite real_cbrt_inverse(x:ℝ):cbrt(x)⁻¹⇒cbrt(x⁻¹);
rewrite real_cbrt_power_multiple(x:ℝ,n:NatParam):cbrt(x)^(3*n+3)⇒x^(n+1);
rewrite real_cbrt_power_one(x:ℝ,n:NatParam):cbrt(x)^(3*n+4)⇒x^(n+1)*cbrt(x);
rewrite real_cbrt_power_two(x:ℝ,n:NatParam):cbrt(x)^(3*n+5)⇒x^(n+1)*cbrt(x)^2;
rewrite real_cbrt_factor_left(x:ℝ,y:ℝ):cbrt(x^3*y)⇒x*cbrt(y);
rewrite real_cbrt_factor_right(x:ℝ,y:ℝ):cbrt(x*y^3)⇒cbrt(x)*y;

rewrite real_tan_asin(x:ℝ):tan(asin(x))⇒x/sqrt(1-x^2);
rewrite real_tan_acos(x:ℝ):tan(acos(x))⇒sqrt(1-x^2)/x;
rewrite complex_tan_asin(x:ℂ):ctan(casin(x))⇒x/csqrt(1-x^2);
rewrite complex_tan_acos(x:ℂ):ctan(cacos(x))⇒csqrt(1-x^2)/x;

rewrite real_asin_neg(x:ℝ):asin(-x)⇒-asin(x);
rewrite real_atan_neg(x:ℝ):atan(-x)⇒-atan(x);
rewrite real_asinh_neg(x:ℝ):asinh(-x)⇒-asinh(x);
rewrite real_atanh_neg(x:ℝ):atanh(-x)⇒-atanh(x);
rewrite real_acos_neg(x:ℝ):acos(-x)⇒π-acos(x);
rewrite real_inverse_trig_complement(x:ℝ):asin(x)+acos(x)⇒π/2;
rewrite complex_inverse_trig_complement(x:ℂ):casin(x)+cacos(x)⇒toℂ(π/2);
rewrite real_asin_negative_literal(x:ℝ):asin(x)⇒-asin(-x) when literal(x),x<0;
rewrite real_atan_negative_literal(x:ℝ):atan(x)⇒-atan(-x) when literal(x),x<0;
rewrite real_asinh_negative_literal(x:ℝ):asinh(x)⇒-asinh(-x) when literal(x),x<0;
rewrite real_atanh_negative_literal(x:ℝ):atanh(x)⇒-atanh(-x) when literal(x),x<0;
rewrite real_acos_negative_literal(x:ℝ):acos(x)⇒π-acos(-x) when literal(x),x<0;

rewrite real_log2_product(x:ℝ,y:ℝ):log2(x*y)⇒log2(x)+log2(y) when 0<x,0<y;
rewrite real_log2_quotient(x:ℝ,y:ℝ):log2(x/y)⇒log2(x)-log2(y) when 0<x,0<y;
rewrite real_log2_inverse(x:ℝ):log2(x⁻¹)⇒-log2(x);
rewrite real_log2_power(x:ℝ,n:NatParam):log2(x^(n+1))⇒(real(n)+1)*log2(x) when 0<x;
rewrite real_log2_matching_power(x:ℝ):log2(powerR(2,x))⇒x;
rewrite real_log10_product(x:ℝ,y:ℝ):log10(x*y)⇒log10(x)+log10(y) when 0<x,0<y;
rewrite real_log10_quotient(x:ℝ,y:ℝ):log10(x/y)⇒log10(x)-log10(y) when 0<x,0<y;
rewrite real_log10_inverse(x:ℝ):log10(x⁻¹)⇒-log10(x);
rewrite real_log10_power(x:ℝ,n:NatParam):log10(x^(n+1))⇒(real(n)+1)*log10(x) when 0<x;
rewrite real_log10_matching_power(x:ℝ):log10(powerR(10,x))⇒x;

# Embeddings commute with indexed powers, including their partial domains.
lemma embed_NZ_powN(x:ℕ,n:ℕ):powZN(castNZ(x),n)⇒castNZ(powNN(x,n));
lemma embed_ZQ_powN(x:ℤ,n:ℕ):powQN(castZQ(x),n)⇒castZQ(powZN(x,n));
lemma embed_QR_powN(x:ℚ,n:ℕ):powRN(castQR(x),n)⇒castQR(powQN(x,n));
lemma embed_RC_powN(x:ℝ,n:ℕ):powCN(castRC(x),n)⇒castRC(powRN(x,n));
lemma embed_QR_powZ(x:ℚ,n:ℤ):powRZ(castQR(x),n)⇒castQR(powQZ(x,n));
lemma embed_RC_powZ(x:ℝ,n:ℤ):powCZ(castRC(x),n)⇒castRC(powRZ(x,n));

# The bottom of the natural order and singleton discrete intervals.
rewrite natural_lt_one(x:ℕ):x<1⇒x=0;
rewrite natural_one_le(x:ℕ):1≤x⇒x≠0;
rewrite natural_unit_interval(x:ℕ):(nonzeroN(x)∧x<2)⇒x=1;
rewrite natural_unit_interval_right(x:ℕ):(x<2∧nonzeroN(x))⇒x=1;
rewrite natural_literal_closed_interval(x:ℕ,a:ℕ):(a≤x∧x≤a)⇒x=a when literal(a);
rewrite natural_literal_closed_interval_right(x:ℕ,a:ℕ):(x≤a∧a≤x)⇒x=a when literal(a);
rewrite integer_literal_closed_interval(x:ℤ,a:ℤ):(a≤x∧x≤a)⇒x=a when literal(a);
rewrite integer_literal_closed_interval_right(x:ℤ,a:ℤ):(x≤a∧a≤x)⇒x=a when literal(a);
rewrite natural_closed_interval(x:ℕ,a:ℕ):(a≤x∧x≤a)⇒x=a;
rewrite natural_closed_interval_right(x:ℕ,a:ℕ):(x≤a∧a≤x)⇒x=a;
rewrite integer_closed_interval(x:ℤ,a:ℤ):(a≤x∧x≤a)⇒x=a;
rewrite integer_closed_interval_right(x:ℤ,a:ℤ):(x≤a∧a≤x)⇒x=a;
lemma natural_literal_lt_right(x:ℕ,a:ℕ,b:ℕ):x<a⇒x≤b when a=b+1,defined(b);
lemma natural_literal_lt_left(x:ℕ,a:ℕ,b:ℕ):a<x⇒b≤x when b=a+1,defined(b);
lemma integer_literal_lt_right(x:ℤ,a:ℤ,b:ℤ):x<a⇒x≤b when a=b+1,defined(b);
lemma integer_literal_lt_left(x:ℤ,a:ℤ,b:ℤ):a<x⇒b≤x when b=a+1,defined(b);
rewrite natural_unit_closed(x:ℕ):(nonzeroN(x)∧x≤1)⇒x=1;
rewrite natural_unit_closed_right(x:ℕ):(x≤1∧nonzeroN(x))⇒x=1;

# Canonicalize masks supplied through implicit or explicit embeddings alike.
rewrite natural_cast_mask(p:𝔹,x:ℕ):castNZ(maskN(p,x))⇒maskZ(p,castNZ(x));
rewrite integer_cast_mask(p:𝔹,x:ℤ):castZQ(maskZ(p,x))⇒maskQ(p,castZQ(x));
rewrite rational_cast_mask(p:𝔹,x:ℚ):castQR(maskQ(p,x))⇒maskR(p,castQR(x));
rewrite real_cast_mask(p:𝔹,x:ℝ):castRC(maskR(p,x))⇒maskC(p,castRC(x));

rewrite real_cos_absolute_argument(x:ℝ):cos(abs(x))⇒cos(x);
rewrite real_cosh_absolute_argument(x:ℝ):cosh(abs(x))⇒cosh(x);
rewrite real_sinh_absolute_value(x:ℝ):abs(sinh(x))⇒sinh(abs(x));

# Restore subtraction patterns after folding a literal comparison offset.
equation integer_add_unit(x:ℤ):x+0≡x;
equation rational_add_unit(x:ℚ):x+0≡x;
equation integer_add_comm(x:ℤ,y:ℤ):x+y≡y+x;
equation rational_add_comm(x:ℚ,y:ℚ):x+y≡y+x;

rewrite real_tanh_absolute_value(x:ℝ):abs(tanh(x))⇒tanh(abs(x));
rewrite real_asinh_absolute_value(x:ℝ):abs(asinh(x))⇒asinh(abs(x));
rewrite real_atan_absolute_value(x:ℝ):abs(atan(x))⇒atan(abs(x));

rewrite real_sign_sinh(x:ℝ):sign(sinh(x))⇒sign(x);
rewrite real_sign_tanh(x:ℝ):sign(tanh(x))⇒sign(x);
rewrite real_sign_asinh(x:ℝ):sign(asinh(x))⇒sign(x);
rewrite real_sign_atan(x:ℝ):sign(atan(x))⇒sign(x);
rewrite real_sign_asin(x:ℝ):sign(asin(x))⇒sign(x);
rewrite real_sign_atanh(x:ℝ):sign(atanh(x))⇒sign(x);

rewrite real_abs_cbrt(x:ℝ):abs(cbrt(x))⇒cbrt(abs(x));
rewrite real_sign_cbrt(x:ℝ):sign(cbrt(x))⇒sign(x);

rewrite real_sign_log(x:ℝ):sign(log(x))⇒sign(x-1);
rewrite real_sign_exp_difference(x:ℝ):sign(exp(x)-1)⇒sign(x);

rewrite real_sign_exp_pair_difference(x:ℝ,y:ℝ):sign(exp(x)-exp(y))⇒sign(x-y);
rewrite real_sign_log_pair_difference(x:ℝ,y:ℝ):sign(log(x)-log(y))⇒sign(x-y);
rewrite real_sign_sinh_pair_difference(x:ℝ,y:ℝ):sign(sinh(x)-sinh(y))⇒sign(x-y);
rewrite real_sign_tanh_pair_difference(x:ℝ,y:ℝ):sign(tanh(x)-tanh(y))⇒sign(x-y);
rewrite real_sign_asinh_pair_difference(x:ℝ,y:ℝ):sign(asinh(x)-asinh(y))⇒sign(x-y);
rewrite real_sign_atan_pair_difference(x:ℝ,y:ℝ):sign(atan(x)-atan(y))⇒sign(x-y);
rewrite real_sign_asin_pair_difference(x:ℝ,y:ℝ):sign(asin(x)-asin(y))⇒sign(x-y);
rewrite real_sign_atanh_pair_difference(x:ℝ,y:ℝ):sign(atanh(x)-atanh(y))⇒sign(x-y);
rewrite real_sign_cbrt_pair_difference(x:ℝ,y:ℝ):sign(cbrt(x)-cbrt(y))⇒sign(x-y);
rewrite real_sign_acosh_pair_difference(x:ℝ,y:ℝ):sign(acosh(x)-acosh(y))⇒sign(x-y);

rewrite real_sign_acos_pair_difference(x:ℝ,y:ℝ):sign(acos(x)-acos(y))⇒sign(y-x);
rewrite real_sign_erfc_pair_difference(x:ℝ,y:ℝ):sign(erfc(x)-erfc(y))⇒sign(y-x);

rewrite real_sign_log2(x:ℝ):sign(log2(x))⇒sign(x-1);
rewrite real_sign_log2_pair_difference(x:ℝ,y:ℝ):sign(log2(x)-log2(y))⇒sign(x-y);
rewrite real_sign_log10(x:ℝ):sign(log10(x))⇒sign(x-1);
rewrite real_sign_log10_pair_difference(x:ℝ,y:ℝ):sign(log10(x)-log10(y))⇒sign(x-y);

rewrite real_sign_acos_half_pi(x:ℝ):sign(acos(x)+real(-1,2)*π)⇒sign(-x);
rewrite real_sign_half_pi_acos(x:ℝ):sign(real(1,2)*π-acos(x))⇒sign(x);
rewrite real_sign_erfc_minus_one(x:ℝ):sign(erfc(x)-1)⇒sign(-x);
rewrite real_sign_one_minus_erfc(x:ℝ):sign(1-erfc(x))⇒sign(x);

rewrite integer_literal_affine_nonzero(a:ℤ,x:ℤ,b:ℤ):a*x+b≠0⇒¬(x=floor(-toℝ(b)/toℝ(a))∧-toℝ(b)/toℝ(a)=toℝ(floor(-toℝ(b)/toℝ(a)))) when literal(a),literal(b),a≠0;
rewrite natural_literal_affine_nonzero(a:ℕ,x:ℕ,b:ℤ):castNZ(a*x)+b≠0⇒¬(0≤-toℝ(b)/toℝ(a)∧castNZ(x)=floor(-toℝ(b)/toℝ(a))∧-toℝ(b)/toℝ(a)=toℝ(floor(-toℝ(b)/toℝ(a)))) when literal(a),literal(b),a≠0;
rewrite natural_positive_offset_nonzero(x:ℕ,b:ℕ):nonzeroN(x+b)⇒true when 0<b;

rewrite integer_nonzero_literal_offsets(x:ℤ,a:ℤ,b:ℤ):(x+a)+b≠0⇒x+(a+b)≠0 when literal(a),literal(b);
rewrite integer_nonzero_literal_offsets_commuted(x:ℤ,a:ℤ,b:ℤ):(a+x)+b≠0⇒x+(a+b)≠0 when literal(a),literal(b);
rewrite natural_nonzero_literal_offsets(x:ℕ,a:ℕ,b:ℤ):castNZ(x+a)+b≠0⇒castNZ(x)+(castNZ(a)+b)≠0 when literal(a),literal(b);
rewrite natural_nonzero_literal_offsets_commuted(x:ℕ,a:ℕ,b:ℤ):castNZ(a+x)+b≠0⇒castNZ(x)+(castNZ(a)+b)≠0 when literal(a),literal(b);
rewrite natural_direct_nonzero_product(x:ℕ,y:ℕ):nonzeroN(x*y)⇒nonzeroN(x)∧nonzeroN(y);
rewrite natural_direct_nonzero_power(x:ℕ,n:NatParam):nonzeroN(x^(n+1))⇒nonzeroN(x);
rewrite natural_direct_nonzero_sum(x:ℕ,y:ℕ):nonzeroN(x+y)⇒nonzeroN(x)∨nonzeroN(y);
