rewrite real_cbrt_ne(x:ℝ,y:ℝ):cbrt(x)≠cbrt(y)⇒x≠y;
rewrite real_acosh_lt(x:ℝ,y:ℝ):acosh(x)<acosh(y)⇒x<y;
rewrite real_acosh_le(x:ℝ,y:ℝ):acosh(x)≤acosh(y)⇒x≤y;
rewrite real_acosh_ne(x:ℝ,y:ℝ):acosh(x)≠acosh(y)⇒x≠y;
rewrite real_atanh_lt(x:ℝ,y:ℝ):atanh(x)<atanh(y)⇒x<y;
rewrite real_atanh_le(x:ℝ,y:ℝ):atanh(x)≤atanh(y)⇒x≤y;
rewrite real_atanh_ne(x:ℝ,y:ℝ):atanh(x)≠atanh(y)⇒x≠y;
rewrite real_erfc_lt(x:ℝ,y:ℝ):erfc(x)<erfc(y)⇒y<x;
rewrite real_erfc_le(x:ℝ,y:ℝ):erfc(x)≤erfc(y)⇒y≤x;
rewrite real_erfc_ne(x:ℝ,y:ℝ):erfc(x)≠erfc(y)⇒x≠y;
rewrite real_acos_lt(x:ℝ,y:ℝ):acos(x)<acos(y)⇒y<x;
rewrite real_acos_le(x:ℝ,y:ℝ):acos(x)≤acos(y)⇒y≤x;
rewrite real_acos_ne(x:ℝ,y:ℝ):acos(x)≠acos(y)⇒x≠y;
rewrite complex_sin_imaginary(z:ℂ):csin(ⅈ*z)⇒ⅈ*csinh(z);
rewrite complex_cos_imaginary(z:ℂ):ccos(ⅈ*z)⇒ccosh(z);
rewrite complex_tan_imaginary(z:ℂ):ctan(ⅈ*z)⇒ⅈ*ctanh(z);
rewrite complex_sinh_imaginary(z:ℂ):csinh(ⅈ*z)⇒ⅈ*csin(z);
rewrite complex_cosh_imaginary(z:ℂ):ccosh(ⅈ*z)⇒ccos(z);
rewrite complex_tanh_imaginary(z:ℂ):ctanh(ⅈ*z)⇒ⅈ*ctan(z);
rewrite complex_sin_real(x:ℝ):csin(toℂ(x))⇒toℂ(sin(x));
rewrite complex_cos_real(x:ℝ):ccos(toℂ(x))⇒toℂ(cos(x));
rewrite complex_tan_real(x:ℝ):ctan(toℂ(x))⇒toℂ(tan(x));
rewrite complex_sinh_real(x:ℝ):csinh(toℂ(x))⇒toℂ(sinh(x));
rewrite complex_cosh_real(x:ℝ):ccosh(toℂ(x))⇒toℂ(cosh(x));
rewrite complex_tanh_real(x:ℝ):ctanh(toℂ(x))⇒toℂ(tanh(x));
lemma real_lt_cancel_pos(a:ℝ,x:ℝ,y:ℝ):a*x<a*y⇒x<y when 0<a;
lemma real_le_cancel_pos(a:ℝ,x:ℝ,y:ℝ):a*x≤a*y⇒x≤y when 0<a;
lemma real_lt_cancel_neg(a:ℝ,x:ℝ,y:ℝ):a*x<a*y⇒y<x when a<0;
lemma real_le_cancel_neg(a:ℝ,x:ℝ,y:ℝ):a*x≤a*y⇒y≤x when a<0;
