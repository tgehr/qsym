fact real_le_lower(x:ℝ,a:ℝ,b:ℝ):b≤x when a<x,b≤a,defined(a);
fact real_le_lower_closed(x:ℝ,a:ℝ,b:ℝ):b≤x when a≤x,b≤a,defined(a);
