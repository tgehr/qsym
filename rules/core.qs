rule complex_inv_inv(x:ℂ):(x⁻¹)⁻¹⇒x;
rule complex_mask_zero(p:𝔹):[p]·complex(0,0)⇒complex(0,0);
rule real_abs_abs(x:ℝ):abs(|x|)⇒|x|;
rule real_abs_neg(x:ℝ):|−x|⇒|x|;
equation real_add_assoc(x:ℝ,y:ℝ,z:ℝ):(x+y)+z≡x+(y+z);
equation real_add_comm(x:ℝ,y:ℝ):x+y≡y+x;
equation real_add_unit(x:ℝ):x+0≡x;
equation real_mul_assoc(x:ℝ,y:ℝ,z:ℝ):(x·y)·z≡x·(y·z);
equation real_mul_comm(x:ℝ,y:ℝ):x·y≡y·x;
equation real_mul_unit(x:ℝ):x·1≡x;
lemma real_distribute(x:ℝ,y:ℝ,z:ℝ):x·(y+z)⇒x·y+x·z;
lemma real_collect(a:ℝ,b:ℝ,x:ℝ):a·x+b·x⇒(a+b)·x;
lemma real_inv_mul(x:ℝ,y:ℝ):(x·y)⁻¹⇒x⁻¹·y⁻¹;
lemma real_mul_inv(x:ℝ,y:ℝ):x⁻¹·y⁻¹⇒(x·y)⁻¹;
lemma real_cancel_factor(x:ℝ,y:ℝ):(x·y)·x⁻¹⇒y;
rewrite real_mask_add(p:𝔹,x:ℝ,y:ℝ):[p]·x+[p]·y⇒[p]·(x+y);
rewrite real_mask_complement(p:𝔹,x:ℝ):[p]·x+[¬p]·x⇒x;
rewrite real_mask_mul_left(p:𝔹,x:ℝ,y:ℝ):mulR(maskR(p,x),y)⇒[p]·(x·y);
rewrite real_mask_mul_right(p:𝔹,x:ℝ,y:ℝ):mulR(x,maskR(p,y))⇒[p]·(x·y);
rewrite real_mask_nested(p:𝔹,q:𝔹,x:ℝ):[p]·([q]·x)⇒[p∧q]·x;
rewrite real_nonzero_product(x:ℝ,y:ℝ):x·y≠0⇒x≠0∧y≠0;
rule real_nonzero_inverse(x:ℝ):x⁻¹≠0⇒true;
