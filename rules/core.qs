rewrite real_lt_even_power(x:ℝ,y:ℝ,n:NatParam):x^(n+n+2)<y^(n+n+2)⇒abs(x)<abs(y);
rewrite real_le_even_power(x:ℝ,y:ℝ,n:NatParam):x^(n+n+2)≤y^(n+n+2)⇒abs(x)≤abs(y);
rewrite real_ne_even_power(x:ℝ,y:ℝ,n:NatParam):x^(n+n+2)≠y^(n+n+2)⇒x≠-y∧x≠y;
rewrite real_lt_nonnegative_power(x:ℝ,y:ℝ,n:NatParam):x^(n+1)<y^(n+1)⇒x<y when 0≤x,0≤y;
rewrite real_le_nonnegative_power(x:ℝ,y:ℝ,n:NatParam):x^(n+1)≤y^(n+1)⇒x≤y when 0≤x,0≤y;

# Native polynomial analysis supplies witnesses; these premises check them.
lemma real_nonzero_scale(p:ℝ,x:ℝ,a:ℝ):p≠0⇒x≠0 when p=a*x,a≠0,defined(a),defined(x);
lemma complex_nonzero_scale(p:ℂ,x:ℂ,a:ℂ):p≠0⇒x≠0 when p=a*x,a≠0,defined(a),defined(x);
lemma real_nonzero_quadratic(p:ℝ,x:ℝ,a:ℝ,b:ℝ,d:ℝ):p≠0⇒x≠-b-sqrt(d)∧x≠-b+sqrt(d) when p=a*((x+b)^2-d),a≠0,0≤d,defined(a),defined(b),defined(d),defined(x);
lemma complex_nonzero_quadratic(p:ℂ,x:ℂ,a:ℂ,b:ℂ,d:ℂ):p≠0⇒x≠-b-csqrt(d)∧x≠-b+csqrt(d) when p=a*((x+b)^2-d),a≠0,defined(a),defined(b),defined(d),defined(x);
lemma real_lt_quadratic_pos(l:ℝ,r:ℝ,x:ℝ,a:ℝ,b:ℝ,d:ℝ):l<r⇒-b-sqrt(d)<x∧x<-b+sqrt(d) when l-r=a*((x+b)^2-d),0<a,0≤d,defined(a),defined(b),defined(d),defined(x);
lemma real_le_quadratic_pos(l:ℝ,r:ℝ,x:ℝ,a:ℝ,b:ℝ,d:ℝ):l≤r⇒-b-sqrt(d)≤x∧x≤-b+sqrt(d) when l-r=a*((x+b)^2-d),0<a,0≤d,defined(a),defined(b),defined(d),defined(x);
lemma real_lt_quadratic_neg(l:ℝ,r:ℝ,x:ℝ,a:ℝ,b:ℝ,d:ℝ):l<r⇒x<-b-sqrt(d)∨-b+sqrt(d)<x when l-r=a*((x+b)^2-d),a<0,0≤d,defined(a),defined(b),defined(d),defined(x);
lemma real_le_quadratic_neg(l:ℝ,r:ℝ,x:ℝ,a:ℝ,b:ℝ,d:ℝ):l≤r⇒x≤-b-sqrt(d)∨-b+sqrt(d)≤x when l-r=a*((x+b)^2-d),a<0,0≤d,defined(a),defined(b),defined(d),defined(x);
lemma real_lt_affine_pos(l:ℝ,r:ℝ,a:ℝ,x:ℝ):l<r⇒x<0 when l-r=a*x,0<a,defined(a),defined(x);
lemma real_lt_affine_neg(l:ℝ,r:ℝ,a:ℝ,x:ℝ):l<r⇒0<x when l-r=a*x,a<0,defined(a),defined(x);
lemma real_le_affine_pos(l:ℝ,r:ℝ,a:ℝ,x:ℝ):l≤r⇒x≤0 when l-r=a*x,0<a,defined(a),defined(x);
lemma real_le_affine_neg(l:ℝ,r:ℝ,a:ℝ,x:ℝ):l≤r⇒0≤x when l-r=a*x,a<0,defined(a),defined(x);
lemma complex_nonzero_factor(p:ℂ,x:ℂ,y:ℂ):p≠0⇒x≠0∧y≠0 when p=x*y,defined(x),defined(y);
lemma real_nonzero_factor(p:ℝ,x:ℝ,y:ℝ):p≠0⇒x≠0∧y≠0 when p=x*y,defined(x),defined(y);
lemma real_lt_factor(l:ℝ,r:ℝ,x:ℝ,y:ℝ):l<r⇒(x<0∧0<y)∨(0<x∧y<0) when l-r=x*y,defined(x),defined(y);
lemma real_le_factor(l:ℝ,r:ℝ,x:ℝ,y:ℝ):l≤r⇒(x≤0∧0≤y)∨(0≤x∧y≤0) when l-r=x*y,defined(x),defined(y);
lemma real_nonzero_definite(p:ℝ,a:ℝ,u:ℝ,v:ℝ):p≠0⇒true when p=a*(u^2+v),a≠0,0<v,defined(a),defined(u),defined(v);
lemma real_lt_definite(l:ℝ,r:ℝ,a:ℝ,u:ℝ,v:ℝ):l<r⇒a<0 when l-r=a*(u^2+v),0<v,defined(a),defined(u),defined(v);
lemma real_le_definite(l:ℝ,r:ℝ,a:ℝ,u:ℝ,v:ℝ):l≤r⇒a≤0 when l-r=a*(u^2+v),0<v,defined(a),defined(u),defined(v);

rule natural_add_zero(x:ℕ):x+0⇒x;
rule natural_zero_add(x:ℕ):0+x⇒x;
rule natural_mul_one(x:ℕ):x·1⇒x;
rule natural_one_mul(x:ℕ):1·x⇒x;
rule natural_mul_zero(x:ℕ):x·0⇒0;
rule natural_zero_mul(x:ℕ):0·x⇒0;
rewrite natural_pow_zero(x:ℕ):x^0⇒1;
rule natural_pow_one(x:ℕ):x^1⇒x;
rule natural_mask_true(x:ℕ):[true]·x⇒x;
rule natural_mask_false(x:ℕ):[false]·x⇒0;
rule integer_add_zero(x:ℤ):x+0⇒x;
rule integer_zero_add(x:ℤ):0+x⇒x;
rule integer_mul_one(x:ℤ):x·1⇒x;
rule integer_one_mul(x:ℤ):1·x⇒x;
rule integer_mul_zero(x:ℤ):x·0⇒0;
rule integer_zero_mul(x:ℤ):0·x⇒0;
rewrite integer_pow_zero(x:ℤ):x^0⇒1;
rule integer_pow_one(x:ℤ):x^1⇒x;
rule integer_mask_true(x:ℤ):[true]·x⇒x;
rule integer_mask_false(x:ℤ):[false]·x⇒0;
rule rational_add_zero(x:ℚ):x+0⇒x;
rule rational_zero_add(x:ℚ):0+x⇒x;
rule rational_mul_one(x:ℚ):x·1⇒x;
rule rational_one_mul(x:ℚ):1·x⇒x;
rule rational_mul_zero(x:ℚ):x·0⇒0;
rule rational_zero_mul(x:ℚ):0·x⇒0;
rewrite rational_pow_zero(x:ℚ):x^0⇒1;
rule rational_pow_one(x:ℚ):x^1⇒x;
rule rational_mask_true(x:ℚ):[true]·x⇒x;
rule rational_mask_false(x:ℚ):[false]·x⇒0;
rule natural_nonnegative(n:ℕ):0≤n⇒true;
rule rational_inv_inv(x:ℚ):(x⁻¹)⁻¹⇒x;
rule real_general_power(x:ℝ,n:NatParam):powerR(x,real(n))⇒x^n;
rule complex_general_power(x:ℂ,n:NatParam):powerC(x,complex(n,0))⇒x^n;
rule expR_zero():expR(0)⇒1;
rule expC_zero():expC(0)⇒complex(1,0);
rule sinR_zero():sinR(0)⇒0;
rule sinC_zero():sinC(0)⇒complex(0,0);
rule cosR_zero():cosR(0)⇒1;
rule cosC_zero():cosC(0)⇒complex(1,0);
rule tanR_zero():tanR(0)⇒0;
rule tanC_zero():tanC(0)⇒complex(0,0);
rule sinhR_zero():sinhR(0)⇒0;
rule sinhC_zero():sinhC(0)⇒complex(0,0);
rule coshR_zero():coshR(0)⇒1;
rule coshC_zero():coshC(0)⇒complex(1,0);
rule tanhR_zero():tanhR(0)⇒0;
rule tanhC_zero():tanhC(0)⇒complex(0,0);
rule sqrtR_zero():sqrtR(0)⇒0;
rule sqrtC_zero():sqrtC(0)⇒complex(0,0);
rule cisR_zero():cisR(0)⇒complex(1,0);
rule logR_one():logR(1)⇒0;
rule logC_one():logC(1)⇒complex(0,0);
rule exp_log_real(x:ℝ):exp(log(x))⇒x;
rule log_exp_real(x:ℝ):log(exp(x))⇒x;
rule exp_log_complex(z:ℂ):cexp(clog(z))⇒z;
rule sqrt_square_real(x:ℝ):sqrt(x^2)⇒abs(x);
rule real_part_cartesian(x:ℝ,y:ℝ):creal(cfromri(x,y))⇒x;
rule imag_part_cartesian(x:ℝ,y:ℝ):cimag(cfromri(x,y))⇒y;
rule bool_eq_true(p:𝔹):eqB(p,true)⇒p;
rule bool_eq_false(p:𝔹):eqB(p,false)⇒¬p;

# Elementary identities; partial functions retain their defined-input semantics.
rule real_exp_product(x:ℝ,y:ℝ):exp(x)·exp(y)⇒exp(x+y);
rule complex_exp_product(x:ℂ,y:ℂ):exp(x)·exp(y)⇒exp(x+y);
rewrite real_exp_quotient(x:ℝ,y:ℝ):exp(x)·exp(y)⁻¹⇒exp(x-y);
rewrite complex_exp_quotient(x:ℂ,y:ℂ):exp(x)·exp(y)⁻¹⇒exp(x-y);
rewrite real_exp_power(x:ℝ,n:NatParam):exp(x)^n⇒exp(real(n)·x);
rewrite complex_exp_power(x:ℂ,n:NatParam):exp(x)^n⇒exp(complex(n,0)·x);
rule real_exp_base(x:ℝ):powerR(e,x)⇒exp(x);
fact real_positive_exp(x:ℝ):0<exp(x);
fact real_nonnegative_sqrt(x:ℝ):0≤sqrt(x);
fact real_positive_sqrt(x:ℝ):0<sqrt(x) when 0<x;
rewrite real_exp_lt(x:ℝ,y:ℝ):exp(x)<exp(y)⇒x<y;
rewrite real_exp_le(x:ℝ,y:ℝ):exp(x)≤exp(y)⇒x≤y;
rewrite real_exp_ne(x:ℝ,y:ℝ):exp(x)≠exp(y)⇒x≠y;
rewrite real_exp_ne_one(x:ℝ):exp(x)≠1⇒x≠0;
rule real_nonzero_exp(x:ℝ):exp(x)≠0⇒true;
rewrite real_exp_lt_one(x:ℝ):exp(x)<1⇒x<0;
rewrite real_exp_le_one(x:ℝ):exp(x)≤1⇒x≤0;
rewrite real_one_lt_exp(x:ℝ):1<exp(x)⇒0<x;
rewrite real_one_le_exp(x:ℝ):1≤exp(x)⇒0≤x;
rewrite real_log_lt(x:ℝ,y:ℝ):log(x)<log(y)⇒x<y;
rewrite real_log_le(x:ℝ,y:ℝ):log(x)≤log(y)⇒x≤y;
rewrite real_log_ne(x:ℝ,y:ℝ):log(x)≠log(y)⇒x≠y;
rewrite real_log_ne_value(x:ℝ,y:ℝ):log(x)≠y⇒x≠exp(y);
rewrite real_nonzero_log(x:ℝ):log(x)≠0⇒x≠1;
rewrite real_log_lt_zero(x:ℝ):log(x)<0⇒x<1;
rewrite real_log_le_zero(x:ℝ):log(x)≤0⇒x≤1;
rewrite real_log_pos(x:ℝ):0<log(x)⇒1<x;
rewrite real_log_nonneg(x:ℝ):0≤log(x)⇒1≤x;
rewrite real_sqrt_lt(x:ℝ,y:ℝ):sqrt(x)<sqrt(y)⇒x<y;
rewrite real_sqrt_le(x:ℝ,y:ℝ):sqrt(x)≤sqrt(y)⇒x≤y;
rewrite real_sqrt_ne(x:ℝ,y:ℝ):sqrt(x)≠sqrt(y)⇒x≠y;
rule real_nonzero_sqrt(x:ℝ):sqrt(x)≠0⇒x≠0;
rewrite real_sqrt_lt_bound(x:ℝ,y:ℝ):sqrt(x)<y⇒0<y∧x<y^2 when literal(y);
rewrite real_sqrt_le_bound(x:ℝ,y:ℝ):sqrt(x)≤y⇒0≤y∧x≤y^2 when literal(y);
rewrite real_lt_sqrt_bound(x:ℝ,y:ℝ):y<sqrt(x)⇒y<0∨y^2<x when literal(y);
rewrite real_le_sqrt_bound(x:ℝ,y:ℝ):y≤sqrt(x)⇒y≤0∨y^2≤x when literal(y);
rewrite real_power_base_lt(x:ℝ,y:ℝ,b:ℝ):powerR(b,x)<powerR(b,y)⇒x<y when 1<b;
rewrite real_power_base_le(x:ℝ,y:ℝ,b:ℝ):powerR(b,x)≤powerR(b,y)⇒x≤y when 1<b;
rewrite real_power_small_base_lt(x:ℝ,y:ℝ,b:ℝ):powerR(b,x)<powerR(b,y)⇒y<x when 0<b,b<1;
rewrite real_power_small_base_le(x:ℝ,y:ℝ,b:ℝ):powerR(b,x)≤powerR(b,y)⇒y≤x when 0<b,b<1;
rewrite real_power_base_ne(x:ℝ,y:ℝ,b:ℝ):powerR(b,x)≠powerR(b,y)⇒x≠y when 0<b,b≠1;
rewrite real_power_exponent_lt(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)<powerR(y,t)⇒x<y when 0<t,0≤x,0≤y;
rewrite real_power_exponent_le(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)≤powerR(y,t)⇒x≤y when 0<t,0≤x,0≤y;
rewrite real_negative_exponent_lt(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)<powerR(y,t)⇒y<x when t<0,0≤x,0≤y;
rewrite real_negative_exponent_le(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)≤powerR(y,t)⇒y≤x when t<0,0≤x,0≤y;
rewrite real_power_exponent_ne(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)≠powerR(y,t)⇒x≠y when t≠0,0≤x,0≤y;
rewrite real_noninteger_exponent_lt(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)<powerR(y,t)⇒x<y when 0<t,¬inZ(t);
rewrite real_noninteger_exponent_le(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)≤powerR(y,t)⇒x≤y when 0<t,¬inZ(t);
rewrite real_noninteger_negative_lt(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)<powerR(y,t)⇒y<x when t<0,¬inZ(t);
rewrite real_noninteger_negative_le(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)≤powerR(y,t)⇒y≤x when t<0,¬inZ(t);
rewrite real_noninteger_exponent_ne(x:ℝ,y:ℝ,t:ℝ):powerR(x,t)≠powerR(y,t)⇒x≠y when ¬inZ(t);
fact real_nonnegative_general_power(x:ℝ,t:ℝ):0≤powerR(x,t) when 0≤x;
fact real_positive_general_power(x:ℝ,t:ℝ):0<powerR(x,t) when 0<x;
rewrite real_nonnegative_inverse_lt(x:ℝ,y:ℝ):x⁻¹<y⁻¹⇒y<x when 0≤x,0≤y;
rewrite real_nonnegative_inverse_le(x:ℝ,y:ℝ):x⁻¹≤y⁻¹⇒y≤x when 0≤x,0≤y;
rewrite real_nonpositive_inverse_lt(x:ℝ,y:ℝ):x⁻¹<y⁻¹⇒y<x when x≤0,y≤0;
rewrite real_nonpositive_inverse_le(x:ℝ,y:ℝ):x⁻¹≤y⁻¹⇒y≤x when x≤0,y≤0;
fact complex_nonzero_real(z:ℂ):z≠0 when creal(z)≠0;
fact complex_nonzero_imag(z:ℂ):z≠0 when cimag(z)≠0;
lemma real_sqrt_scale(x:ℝ,a:ℝ,b:ℝ):sqrt(x)⇒a*sqrt(b) when x=a^2*b,0≤a,0≤b,defined(a),defined(b);
rewrite complex_sqrt_real_nonnegative(z:ℂ):csqrt(z)⇒toℂ(sqrt(creal(z))) when cimag(z)=0,0≤creal(z);
rewrite complex_sqrt_real_negative(z:ℂ):csqrt(z)⇒ⅈ*toℂ(sqrt(-creal(z))) when cimag(z)=0,creal(z)<0;
fact real_positive_pi():0<π;
fact real_positive_e():0<e;
rewrite real_log_product(x:ℝ,y:ℝ):log(x·y)⇒log(x)+log(y) when 0≤x;
rewrite real_log_product_right(x:ℝ,y:ℝ):log(x·y)⇒log(x)+log(y) when 0≤y;
rewrite real_log_power(x:ℝ,n:NatParam):log(x^n)⇒real(n)·log(x) when 0<x;
rewrite real_log_square(x:ℝ):log(x^2)⇒2·log(abs(x));
rewrite real_log_inverse(x:ℝ):log(x⁻¹)⇒-log(x);
rewrite real_log_sqrt(x:ℝ):log(sqrt(x))⇒real(1,2)·log(x);
rewrite real_log_odd_power(x:ℝ,n:NatParam):log(x^(n+n+1))⇒(2*real(n)+1)*log(x);
lemma real_log_rational(x:ℝ,y:ℝ,z:ℝ):log(x)⇒log(y)-log(z) when x=y/z,0<y,0<z,defined(y),defined(z);
lemma real_log_exact_power(x:ℝ,b:ℝ,n:NatParam):log(x)⇒(real(n)+2)*log(b) when b^(n+2)=x,0<b,defined(b);
rule real_half_power(x:ℝ):powerR(x,real(1,2))⇒sqrt(x);
rule real_sqrt_squared(x:ℝ):sqrt(x)^2⇒x;
lemma real_sqrt_exact(x:ℝ,y:ℝ):sqrt(x)⇒y when y^2=x,0≤y,defined(y);
lemma real_power_exact(x:ℝ,y:ℝ,z:ℝ,m:NatParam,n:NatParam):powerR(x,z)⇒y^m when z=real(m)/(real(n)+1),y^(n+1)=x,0≤y,defined(y);
rule real_general_power_product(x:ℝ,y:ℝ,z:ℝ):powerR(x,y)·powerR(x,z)⇒powerR(x,y+z) when 0<x;
rewrite real_general_power_nested(x:ℝ,y:ℝ,z:ℝ):powerR(powerR(x,y),z)⇒powerR(x,y·z) when 0<x;
rule real_one_power(x:ℝ):powerR(1,x)⇒1;
rule complex_one_power(z:ℂ):powerC(1,z)⇒complex(1,0);
rule real_zero_power(x:ℝ):powerR(0,x)⇒0 when 0<x;
rule real_min_left(x:ℝ,y:ℝ):min(x,y)⇒x when x≤y;
rule real_min_right(x:ℝ,y:ℝ):min(x,y)⇒y when y≤x;
rule real_max_left(x:ℝ,y:ℝ):max(x,y)⇒x when y≤x;
rule real_max_right(x:ℝ,y:ℝ):max(x,y)⇒y when x≤y;
rewrite real_sign_positive(x:ℝ):sign(x)⇒int(1) when 0<x;
rewrite real_sign_negative(x:ℝ):sign(x)⇒int(-1) when x<0;
rewrite real_sign_zero(x:ℝ):sign(x)⇒int(0) when x=0;
rule real_trig_identity(x:ℝ):sin(x)^2+cos(x)^2⇒1;
rule complex_trig_identity(z:ℂ):sin(z)^2+cos(z)^2⇒complex(1,0);
rewrite real_sin_neg(x:ℝ):sin(-x)⇒-sin(x);
rule real_cos_neg(x:ℝ):cos(-x)⇒cos(x);
rewrite real_tan_neg(x:ℝ):tan(-x)⇒-tan(x);
rewrite complex_sin_neg(z:ℂ):sin(-z)⇒-sin(z);
rule complex_cos_neg(z:ℂ):cos(-z)⇒cos(z);
rewrite real_sinh_neg(x:ℝ):sinh(-x)⇒-sinh(x);
rule real_cosh_neg(x:ℝ):cosh(-x)⇒cosh(x);
rule real_hyperbolic_identity(x:ℝ):cosh(x)^2-sinh(x)^2⇒1;
rule real_tan_atan(x:ℝ):tan(atan(x))⇒x;
rule real_sin_asin(x:ℝ):sin(asin(x))⇒x;
rule real_cos_acos(x:ℝ):cos(acos(x))⇒x;
rule real_asin_sin(x:ℝ):asin(sin(x))⇒x when -real(1,2)·π≤x,x≤real(1,2)·π;
rule real_acos_cos(x:ℝ):acos(cos(x))⇒x when 0≤x,x≤π;
rule real_sin_pi():sin(π)⇒0;
rule real_cos_pi():cos(π)⇒-1;
rule real_sin_half_pi():sin(real(1,2)·π)⇒1;
rule real_cos_half_pi():cos(real(1,2)·π)⇒0;
rule real_sin_three_half_pi():sin(real(3,2)·π)⇒-1;
rule real_cos_three_half_pi():cos(real(3,2)·π)⇒0;
rule real_sin_sixth_pi():sin(real(1,6)·π)⇒real(1,2);
rule real_cos_third_pi():cos(real(1,3)·π)⇒real(1,2);
rewrite real_cos_quarter_pi():cos(real(1,4)·π)⇒real(1,2)·sqrt(2);
rewrite real_sin_quarter_pi():sin(real(1,4)·π)⇒real(1,2)·sqrt(2);
lemma real_sin_period(x:ℝ,n:ℤ):sin(x)⇒sin(x-toℝ(n)·(2·π)) when defined(n);
lemma real_cos_period(x:ℝ,n:ℤ):cos(x)⇒cos(x-toℝ(n)·(2·π)) when defined(n);
rewrite complex_exp_conj(z:ℂ):conj(exp(z))⇒exp(conj(z));
rewrite real_part_sum(z:ℂ,w:ℂ):creal(z+w)⇒creal(z)+creal(w);
rewrite imaginary_part_sum(z:ℂ,w:ℂ):cimag(z+w)⇒cimag(z)+cimag(w);
rewrite real_part_product(z:ℂ,w:ℂ):creal(z·w)⇒creal(z)·creal(w)-cimag(z)·cimag(w);
rewrite imaginary_part_product(z:ℂ,w:ℂ):cimag(z·w)⇒creal(z)·cimag(w)+cimag(z)·creal(w);
rule real_part_cast(x:ℝ):creal(toℂ(x))⇒x;
rule imaginary_part_cast(x:ℝ):cimag(toℂ(x))⇒0;
rewrite complex_cast_sum(x:ℝ,y:ℝ):toℂ(x+y)⇒toℂ(x)+toℂ(y);
rewrite complex_cast_product(x:ℝ,y:ℝ):toℂ(x*y)⇒toℂ(x)*toℂ(y);
rewrite complex_cast_power(x:ℝ,n:NatParam):toℂ(x)^n⇒toℂ(x^n);
rewrite real_sqrt_power(x:ℝ,n:NatParam):sqrt(x)^(n+2)⇒x*sqrt(x)^n;
rule complex_reconstruction(z:ℂ):cfromri(creal(z),cimag(z))⇒z;
rewrite complex_norm_product(z:ℂ,w:ℂ):cabs(z·w)⇒cabs(z)·cabs(w);
rule complex_norm_conj(z:ℂ):cabs(conj(z))⇒cabs(z);
rule complex_phase_product(x:ℝ,y:ℝ):cis(x)·cis(y)⇒cis(x+y);
rule complex_phase_norm(x:ℝ):cabs(cis(x))⇒1;
rewrite complex_exp_phase(z:ℂ):cexp(z)⇒cis(cimag(z)) when creal(z)=0;
rule complex_phase_pi():cis(π)⇒complex(-1,0);
rule complex_phase_half_pi():cis(real(1,2)·π)⇒ⅈ;
lemma complex_phase_period(x:ℝ,n:ℤ):cis(x)⇒cis(x-toℝ(n)·(2·π)) when defined(n);
lemma real_solve_affine(x:ℝ,a:ℝ,b:ℝ):x⇒-b/a when a·x+b=0,a≠0,defined(a),defined(b);
lemma complex_solve_affine(x:ℂ,a:ℂ,b:ℂ):x⇒-b/a when a·x+b=0,a≠0,defined(a),defined(b);

lemma real_floor_exact(x:ℝ,n:ℤ):floor(x)⇒n when toℝ(n)≤x,x<toℝ(n)+1,defined(n);
lemma real_ceil_exact(x:ℝ,n:ℤ):ceil(x)⇒n when toℝ(n)-1<x,x≤toℝ(n),defined(n);
rule real_floor_cast(n:ℤ):floor(toℝ(n))⇒n;
rule real_ceil_cast(n:ℤ):ceil(toℝ(n))⇒n;
rewrite real_floor_neg(x:ℝ):floor(-x)⇒-ceil(x);
rewrite real_ceil_neg(x:ℝ):ceil(-x)⇒-floor(x);
rewrite real_floor_shift(x:ℝ,n:ℤ):floor(x+toℝ(n))⇒floor(x)+n;
rewrite real_ceil_shift(x:ℝ,n:ℤ):ceil(x+toℝ(n))⇒ceil(x)+n;
lemma real_floor_shift_literal(x:ℝ,c:ℝ,n:ℤ):floor(x+c)⇒floor(x)+n when c=toℝ(n),defined(n);
lemma real_ceil_shift_literal(x:ℝ,c:ℝ,n:ℤ):ceil(x+c)⇒ceil(x)+n when c=toℝ(n),defined(n);
rewrite real_floor_lt(x:ℝ,n:ℤ):floor(x)<n⇒x<toℝ(n);
rewrite real_floor_le(x:ℝ,n:ℤ):floor(x)≤n⇒x<toℝ(n)+1;
rewrite real_lt_floor(x:ℝ,n:ℤ):n<floor(x)⇒toℝ(n)+1≤x;
rewrite real_le_floor(x:ℝ,n:ℤ):n≤floor(x)⇒toℝ(n)≤x;
rewrite real_floor_ne(x:ℝ,n:ℤ):floor(x)≠n⇒x<toℝ(n)∨toℝ(n)+1≤x;
rewrite real_ceil_lt(x:ℝ,n:ℤ):ceil(x)<n⇒x≤toℝ(n)-1;
rewrite real_ceil_le(x:ℝ,n:ℤ):ceil(x)≤n⇒x≤toℝ(n);
rewrite real_lt_ceil(x:ℝ,n:ℤ):n<ceil(x)⇒toℝ(n)<x;
rewrite real_le_ceil(x:ℝ,n:ℤ):n≤ceil(x)⇒toℝ(n)-1<x;
rewrite real_ceil_ne(x:ℝ,n:ℤ):ceil(x)≠n⇒x≤toℝ(n)-1∨toℝ(n)<x;
fact real_floor_bound(x:ℝ):toℝ(floor(x))≤x;
fact real_ceil_bound(x:ℝ):x≤toℝ(ceil(x));
rewrite real_round(x:ℝ):round(x)⇒floor(x+real(1,2));
rewrite real_is_integer(x:ℝ):inZ(x)⇒x=toℝ(floor(x));
rewrite real_hypot(x:ℝ,y:ℝ):hypot(x,y)⇒sqrt(x^2+y^2);
# Principal-branch identities; real powers in (0,1] cannot wrap the argument.
rewrite complex_arg_real_power(z:ℂ,w:ℂ):carg(powerC(z,w))⇒creal(w)*carg(z) when cimag(w)=0,0<creal(w),creal(w)≤1;
rewrite complex_log_real_power(z:ℂ,w:ℂ):clog(powerC(z,w))⇒w*clog(z) when cimag(w)=0,0<creal(w),creal(w)≤1;
rewrite complex_power_exponent_ne(z:ℂ,w:ℂ,t:ℂ):powerC(z,t)≠powerC(w,t)⇒z≠w when cimag(t)=0,0<creal(t),creal(t)≤1;
rewrite complex_negative_exponent_ne(z:ℂ,w:ℂ,t:ℂ):powerC(z,t)≠powerC(w,t)⇒z≠w when cimag(t)=0,-1≤creal(t),creal(t)<0;
rewrite complex_power_nonzero(z:ℂ,t:ℂ):powerC(z,t)≠0⇒z≠0 when t≠0;
rewrite complex_arg_sqrt(z:ℂ):carg(csqrt(z))⇒real(1,2)*carg(z);
rewrite complex_log_sqrt(z:ℂ):clog(csqrt(z))⇒clog(z)/2;
rewrite complex_norm_sqrt(z:ℂ):cabs(csqrt(z))⇒sqrt(cabs(z));
rewrite complex_sqrt_squared(z:ℂ):csqrt(z)^2⇒z;
rewrite complex_norm_real_power(z:ℂ,w:ℂ):cabs(powerC(z,w))⇒powerR(cabs(z),creal(w)) when cimag(w)=0;
rewrite complex_norm_exp(z:ℂ):cabs(cexp(z))⇒exp(creal(z));
rewrite complex_norm_inverse(z:ℂ):cabs(z⁻¹)⇒cabs(z)⁻¹;
rewrite complex_norm_power(z:ℂ,n:NatParam):cabs(z^n)⇒cabs(z)^n;
rewrite complex_norm_cast(x:ℝ):cabs(toℂ(x))⇒abs(x);
rewrite complex_log_real_part(z:ℂ):creal(clog(z))⇒log(cabs(z));
rewrite complex_log_imaginary_part(z:ℂ):cimag(clog(z))⇒carg(z);
rewrite complex_log_exp(z:ℂ):clog(cexp(z))⇒z when -π<cimag(z),cimag(z)≤π;
rewrite complex_log_positive_real(z:ℂ):clog(z)⇒toℂ(log(creal(z))) when cimag(z)=0,0<creal(z);
rewrite complex_log_scale(z:ℂ,w:ℂ):clog(z*w)⇒clog(z)+clog(w) when cimag(z)=0,0<creal(z);
rewrite complex_log_scale_right(z:ℂ,w:ℂ):clog(z*w)⇒clog(z)+clog(w) when cimag(w)=0,0<creal(w);
rewrite complex_log_inverse(z:ℂ):clog(z⁻¹)⇒-clog(z) when carg(z)≠π;
rewrite complex_arg_exp(z:ℂ):carg(cexp(z))⇒cimag(z) when -π<cimag(z),cimag(z)≤π;
rewrite complex_arg_phase(x:ℝ):carg(cis(x))⇒x when -π<x,x≤π;
rewrite real_sinh_asinh(x:ℝ):sinh(asinh(x))⇒x;
rewrite real_asinh_sinh(x:ℝ):asinh(sinh(x))⇒x;
rewrite real_cos_asin(x:ℝ):cos(asin(x))⇒sqrt(1-x^2);
rewrite real_sin_acos(x:ℝ):sin(acos(x))⇒sqrt(1-x^2);
rewrite complex_sin_conj(z:ℂ):conj(csin(z))⇒csin(conj(z));
rewrite complex_cos_conj(z:ℂ):conj(ccos(z))⇒ccos(conj(z));
rewrite complex_sinh_conj(z:ℂ):conj(csinh(z))⇒csinh(conj(z));
rewrite complex_cosh_conj(z:ℂ):conj(ccosh(z))⇒ccosh(conj(z));
rewrite complex_abs_cartesian(z:ℂ):cabs(z)⇒sqrt(creal(z)^2+cimag(z)^2) when literal(z);
rewrite real_cbrt_nonnegative(x:ℝ):cbrt(x)⇒powerR(x,real(1,3)) when 0≤x;
rewrite real_cbrt_negative(x:ℝ):cbrt(x)⇒-powerR(-x,real(1,3)) when x<0;
rewrite real_exp2(x:ℝ):exp2(x)⇒powerR(2,x);
rewrite real_power_negative(x:ℝ,y:ℝ):powerR(x,y)⇒powerR(x,-y)⁻¹ when y<0;
lemma real_log2_exact(x:ℝ,y:ℝ):log2(x)⇒y when powerR(2,y)=x,defined(y);
lemma real_log10_exact(x:ℝ,y:ℝ):log10(x)⇒y when powerR(10,y)=x,defined(y);
lemma complex_sqrt_exact(z:ℂ,w:ℂ):csqrt(z)⇒w when w^2=z,0<creal(w),defined(w);
lemma complex_sqrt_imaginary(z:ℂ,y:ℝ):csqrt(z)⇒toℂ(y)*ⅈ when toℂ(-y^2)=z,0≤y,defined(y);
rewrite complex_polar(r:ℝ,t:ℝ):cfromrt(r,t)⇒toℂ(r)*cis(t);
rewrite complex_expi(z:ℂ):cexpi(z)⇒exp(ⅈ*z);
rewrite real_atan2(y:ℝ,x:ℝ):atan2(y,x)⇒carg(cfromri(x,y));
rewrite complex_arg_positive(z:ℂ):carg(z)⇒0 when cimag(z)=0,0<creal(z);
rewrite complex_arg_negative(z:ℂ):carg(z)⇒π when cimag(z)=0,creal(z)<0;
rewrite complex_arg_positive_imag(z:ℂ):carg(z)⇒real(1,2)*π when creal(z)=0,0<cimag(z);
rewrite complex_arg_negative_imag(z:ℂ):carg(z)⇒-real(1,2)*π when creal(z)=0,cimag(z)<0;
rule real_exp_one():exp(1)⇒e;
rule real_log_e():log(e)⇒1;
rule real_asin_zero():asin(0)⇒0;
rewrite real_asin_one():asin(1)⇒real(1,2)*π;
rewrite real_acos_zero():acos(0)⇒real(1,2)*π;
rule real_acos_one():acos(1)⇒0;
rule real_acos_neg_one():acos(-1)⇒π;
rule real_atan_zero():atan(0)⇒0;
rewrite real_atan_one():atan(1)⇒real(1,4)*π;
rule real_asinh_zero():asinh(0)⇒0;
rule real_acosh_one():acosh(1)⇒0;
rule real_atanh_zero():atanh(0)⇒0;
