rewrite complex_exp_log_affine_left(z:ℂ,w:ℂ,t:ℂ):cexp(w*clog(z)+t)⇒powerC(z,w)*cexp(t);
rule complex_exp_nonzero(z:ℂ):cexp(z)≠0⇒true;
rewrite complex_log_ne(z:ℂ,w:ℂ):clog(z)≠clog(w)⇒z≠w;
rewrite complex_log_nonzero(z:ℂ):clog(z)≠0⇒z≠1;
rewrite complex_sqrt_ne(z:ℂ,w:ℂ):csqrt(z)≠csqrt(w)⇒z≠w;
rewrite complex_sqrt_nonzero(z:ℂ):csqrt(z)≠0⇒z≠0;
rewrite complex_exp_strip_ne(z:ℂ,w:ℂ):cexp(z)≠cexp(w)⇒z≠w when -π<cimag(z),cimag(z)≤π,-π<cimag(w),cimag(w)≤π;
rewrite complex_norm_cartesian(x:ℝ,y:ℝ):cabs(cfromri(x,y))⇒sqrt(x^2+y^2);
