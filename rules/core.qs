# Rules preserve values wherever the input is defined; domains may grow.
# rule decreases size; rewrite is budgeted; lemma/equation is selected; fact proves a predicate.
# All declarations produce Lean proof obligations.
rule real_add_zero(x:ℝ):x+0⇒x;
rule real_zero_add(x:ℝ):0+x⇒x;
rule real_mul_one(x:ℝ):x·1⇒x;
rule real_one_mul(x:ℝ):1·x⇒x;
rule real_mask_true(x:ℝ):[true]·x⇒x;
rule real_mask_false(x:ℝ):[false]·x⇒0;
rule complex_add_zero(x:ℂ):x+0⇒x;
rule complex_zero_add(x:ℂ):0+x⇒x;
rule complex_mul_one(x:ℂ):x·1⇒x;
rule complex_one_mul(x:ℂ):1·x⇒x;
rule complex_mask_true(x:ℂ):[true]·x⇒x;
rule complex_mask_false(x:ℂ):[false]·x⇒0;
rule complex_conj_conj(x:ℂ):conj(conj(x))⇒x;
rule erase_puncture(d:Density):forget(puncture(d))⇒forget(d);
rule real_mul_zero(x:ℝ):x·0⇒0;
rule real_zero_mul(x:ℝ):0·x⇒0;
rule real_div_self(x:ℝ):x·x⁻¹⇒1;
rule real_inv_inv(x:ℝ):(x⁻¹)⁻¹⇒x;
rule real_mask_zero(p:𝔹):[p]·0⇒0;
rule complex_mul_zero(x:ℂ):x·0⇒0;
rule complex_zero_mul(x:ℂ):0·x⇒0;
rule complex_div_self(x:ℂ):x·x⁻¹⇒1;
rule complex_inv_inv(x:ℂ):(x⁻¹)⁻¹⇒x;
rule complex_mask_zero(p:𝔹):[p]·complex(0,0)⇒complex(0,0);
rule real_abs_abs(x:ℝ):abs(|x|)⇒|x|;
rule real_abs_neg(x:ℝ):|−x|⇒|x|;
equation real_add_assoc(x:ℝ,y:ℝ,z:ℝ):(x+y)+z≡x+(y+z);
equation real_add_comm(x:ℝ,y:ℝ):x+y≡y+x;
equation real_add_unit(x:ℝ):x+0≡x;
equation real_mul_assoc(x:ℝ,y:ℝ,z:ℝ):(x·y)·z≡x·(y·z);
equation real_mul_comm(x:ℝ,y:ℝ):x·y≡y·x;
equation real_mul_unit(x:ℝ):x·1≡x;
lemma real_distribute(x:ℝ,y:ℝ,z:ℝ):x·(y+z)⇒x·y+x·z;
lemma real_collect(a:ℝ,b:ℝ,x:ℝ):a·x+b·x⇒(a+b)·x;
lemma real_inv_mul(x:ℝ,y:ℝ):(x·y)⁻¹⇒x⁻¹·y⁻¹;
lemma real_mul_inv(x:ℝ,y:ℝ):x⁻¹·y⁻¹⇒(x·y)⁻¹;
lemma real_cancel_factor(x:ℝ,y:ℝ):(x·y)·x⁻¹⇒y;
rewrite real_mask_add(p:𝔹,x:ℝ,y:ℝ):[p]·x+[p]·y⇒[p]·(x+y);
rewrite real_mask_complement(p:𝔹,x:ℝ):[p]·x+[¬p]·x⇒x;
rewrite real_mask_mul_left(p:𝔹,x:ℝ,y:ℝ):([p]·x)·y⇒[p]·(x·y);
rewrite real_mask_mul_right(p:𝔹,x:ℝ,y:ℝ):x·([p]·y)⇒[p]·(x·y);
rewrite real_mask_nested(p:𝔹,q:𝔹,x:ℝ):[p]·([q]·x)⇒[p∧q]·x;
rewrite real_nonzero_product(x:ℝ,y:ℝ):x·y≠0⇒x≠0∧y≠0;
rule real_nonzero_inverse(x:ℝ):x⁻¹≠0⇒true;
lemma real_pow_split(x:ℝ,m:NatParam,n:NatParam):x^(m+n)⇒x^m·x^n;
lemma real_pow_join(x:ℝ,m:NatParam,n:NatParam):x^m·x^n⇒x^(m+n);
lemma real_pow_product(x:ℝ,y:ℝ,n:NatParam):(x·y)^n⇒x^n·y^n;
lemma real_pow_power(x:ℝ,m:NatParam,n:NatParam):(x^m)^n⇒x^(m·n);
lemma real_inv_power(x:ℝ,n:NatParam):(x^(n+1))⁻¹⇒(x⁻¹)^(n+1);
lemma real_power_inv(x:ℝ,n:NatParam):(x⁻¹)^n⇒(x^n)⁻¹;
rewrite real_pow_zero(x:ℝ):x^0⇒1;
rule real_pow_one(x:ℝ):x^1⇒x;
lemma real_divide_step(p:ℝ,d:ℝ,q:ℝ):p·d⁻¹⇒q+(p−q·d)·d⁻¹ when defined(q);
rewrite real_nonzero_power(x:ℝ,n:NatParam):x^(n+1)≠0⇒x≠0;
equation complex_add_assoc(x:ℂ,y:ℂ,z:ℂ):(x+y)+z≡x+(y+z);
equation complex_add_comm(x:ℂ,y:ℂ):x+y≡y+x;
equation complex_add_unit(x:ℂ):x+0≡x;
equation complex_mul_assoc(x:ℂ,y:ℂ,z:ℂ):(x·y)·z≡x·(y·z);
equation complex_mul_comm(x:ℂ,y:ℂ):x·y≡y·x;
equation complex_mul_unit(x:ℂ):x·1≡x;
lemma complex_distribute(x:ℂ,y:ℂ,z:ℂ):x·(y+z)⇒x·y+x·z;
lemma complex_collect(a:ℂ,b:ℂ,x:ℂ):a·x+b·x⇒(a+b)·x;
lemma complex_inv_mul(x:ℂ,y:ℂ):(x·y)⁻¹⇒x⁻¹·y⁻¹;
lemma complex_mul_inv(x:ℂ,y:ℂ):x⁻¹·y⁻¹⇒(x·y)⁻¹;
lemma complex_cancel_factor(x:ℂ,y:ℂ):(x·y)·x⁻¹⇒y;
rewrite complex_mask_add(p:𝔹,x:ℂ,y:ℂ):[p]·x+[p]·y⇒[p]·(x+y);
rewrite complex_mask_complement(p:𝔹,x:ℂ):[p]·x+[¬p]·x⇒x;
rewrite complex_mask_mul_left(p:𝔹,x:ℂ,y:ℂ):([p]·x)·y⇒[p]·(x·y);
rewrite complex_mask_mul_right(p:𝔹,x:ℂ,y:ℂ):x·([p]·y)⇒[p]·(x·y);
