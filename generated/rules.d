bool pairCandidate(Law law,Node x,Node y){
	switch(law){
		case Law.real_div_self:return true&&y.op==Op.inv;
		case Law.complex_div_self:return true&&y.op==Op.inv;
		case Law.real_mask_add:return x.op==Op.mask&&y.op==Op.mask;
		case Law.real_mask_complement:return x.op==Op.mask&&y.op==Op.mask;
		case Law.complex_mask_add:return x.op==Op.mask&&y.op==Op.mask;
		case Law.complex_mask_complement:return x.op==Op.mask&&y.op==Op.mask;
		case Law.real_exp_product:return x.op==Op.builtin&&x.value==Builtin.expR&&y.op==Op.builtin&&y.value==Builtin.expR;
		case Law.complex_exp_product:return x.op==Op.builtin&&x.value==Builtin.expC&&y.op==Op.builtin&&y.value==Builtin.expC;
		case Law.real_exp_quotient:return x.op==Op.builtin&&x.value==Builtin.expR&&y.op==Op.inv;
		case Law.complex_exp_quotient:return x.op==Op.builtin&&x.value==Builtin.expC&&y.op==Op.inv;
		case Law.real_general_power_product:return x.op==Op.builtin&&x.value==Builtin.powerR&&y.op==Op.builtin&&y.value==Builtin.powerR;
		case Law.real_trig_identity:return x.op==Op.pow&&y.op==Op.pow;
		case Law.complex_trig_identity:return x.op==Op.pow&&y.op==Op.pow;
		case Law.real_hyperbolic_identity:return x.op==Op.pow&&y.op==Op.mul;
		case Law.complex_phase_product:return x.op==Op.builtin&&x.value==Builtin.cisR&&y.op==Op.builtin&&y.value==Builtin.cisR;
		case Law.real_min_max_sum:return x.op==Op.builtin&&x.value==Builtin.minR&&y.op==Op.builtin&&y.value==Builtin.maxR;
		case Law.real_min_max_product:return x.op==Op.builtin&&x.value==Builtin.minR&&y.op==Op.builtin&&y.value==Builtin.maxR;
		case Law.real_sqrt_product:return x.op==Op.builtin&&x.value==Builtin.sqrtR&&y.op==Op.builtin&&y.value==Builtin.sqrtR;
		case Law.real_power_product_base:return x.op==Op.builtin&&x.value==Builtin.powerR&&y.op==Op.builtin&&y.value==Builtin.powerR;
		case Law.real_sin_cos_product:return x.op==Op.builtin&&x.value==Builtin.sinR&&y.op==Op.builtin&&y.value==Builtin.cosR;
		case Law.complex_sin_cos_product:return x.op==Op.builtin&&x.value==Builtin.sinC&&y.op==Op.builtin&&y.value==Builtin.cosC;
		case Law.complex_hyperbolic_identity:return x.op==Op.pow&&y.op==Op.mul;
		case Law.complex_conjugate_product:return true&&y.op==Op.conj;
		case Law.complex_exp_real_product:return x.op==Op.builtin&&x.value==Builtin.expC&&y.op==Op.builtin&&y.value==Builtin.castRC;
		case Law.complex_real_exp_product:return x.op==Op.builtin&&x.value==Builtin.castRC&&y.op==Op.builtin&&y.value==Builtin.castRC;
		case Law.complex_phase_exp_product:return x.op==Op.builtin&&x.value==Builtin.expC&&y.op==Op.builtin&&y.value==Builtin.cisR;
		case Law.complex_phase_real_exp_product:return x.op==Op.builtin&&x.value==Builtin.castRC&&y.op==Op.builtin&&y.value==Builtin.cisR;
		case Law.real_sin_cos_ratio:return x.op==Op.builtin&&x.value==Builtin.sinR&&y.op==Op.inv;
		case Law.real_sinh_cosh_ratio:return x.op==Op.builtin&&x.value==Builtin.sinhR&&y.op==Op.inv;
		case Law.complex_sin_cos_ratio:return x.op==Op.builtin&&x.value==Builtin.sinC&&y.op==Op.inv;
		case Law.complex_sinh_cosh_ratio:return x.op==Op.builtin&&x.value==Builtin.sinhC&&y.op==Op.inv;
		case Law.real_tan_cos_product:return x.op==Op.builtin&&x.value==Builtin.tanR&&y.op==Op.builtin&&y.value==Builtin.cosR;
		case Law.real_tanh_cosh_product:return x.op==Op.builtin&&x.value==Builtin.tanhR&&y.op==Op.builtin&&y.value==Builtin.coshR;
		case Law.complex_tan_cos_product:return x.op==Op.builtin&&x.value==Builtin.tanC&&y.op==Op.builtin&&y.value==Builtin.cosC;
		case Law.complex_tanh_cosh_product:return x.op==Op.builtin&&x.value==Builtin.tanhC&&y.op==Op.builtin&&y.value==Builtin.coshC;
		case Law.real_cosh_sinh_sum:return x.op==Op.builtin&&x.value==Builtin.coshR&&y.op==Op.builtin&&y.value==Builtin.sinhR;
		case Law.real_cosh_sinh_difference:return x.op==Op.builtin&&x.value==Builtin.coshR&&y.op==Op.mul;
		case Law.complex_cosh_sinh_sum:return x.op==Op.builtin&&x.value==Builtin.coshC&&y.op==Op.builtin&&y.value==Builtin.sinhC;
		case Law.complex_cosh_sinh_difference:return x.op==Op.builtin&&x.value==Builtin.coshC&&y.op==Op.mul;
		case Law.real_sin_addition:return x.op==Op.mul&&y.op==Op.mul;
		case Law.real_cos_difference:return x.op==Op.mul&&y.op==Op.mul;
		case Law.complex_sin_addition:return x.op==Op.mul&&y.op==Op.mul;
		case Law.complex_cos_difference:return x.op==Op.mul&&y.op==Op.mul;
		case Law.real_cos_double:return x.op==Op.pow&&y.op==Op.mul;
		case Law.complex_cos_double:return x.op==Op.pow&&y.op==Op.mul;
		case Law.real_difference_squares:return x.op==Op.add&&y.op==Op.add;
		case Law.complex_difference_squares:return x.op==Op.add&&y.op==Op.add;
		case Law.real_difference_squares_literals:return x.op==Op.add&&y.op==Op.add;
		case Law.complex_difference_squares_literals:return x.op==Op.add&&y.op==Op.add;
		case Law.real_cbrt_product:return x.op==Op.builtin&&x.value==Builtin.cbrtR&&y.op==Op.builtin&&y.value==Builtin.cbrtR;
		default:return false;
	}
}
