@@ -0,0 +1,166 @@
+module qsym.derive;
+import qsym.ir;
+import qsym.generated.rules:Instance;
+import qsym.table:Table;
+import std.exception:enforce;
+@safe:
+
+struct Proof{ Term before,after; uint id=uint.max,context; bool known; }
+struct Context{ uint parent; Term guard; bool value; }
+enum Evidence{ rule,trans,congr,scoped,assumption,transport,numeric,ac }
+struct DomainProof{ Term term; uint[] path; DomainProof[] children; bool found,total; }
+struct Deduction{
+	Evidence kind;
+	Proof proof;
+	Proof[] premises;
+	Instance instance;
+	DomainProof[] domains;
+	uint assumptionScope;
+	uint[] path;
+	bool value;
+}
+
+// D records choices. The exporter must justify every choice with a theorem.
+final class Derivation{
+	Arena arena;
+	bool tracing;
+	Deduction[] deductions;
+	Context[] contexts=[Context.init];
+	this(Arena a,bool tracing){ arena=a; this.tracing=tracing; }
+	Proof refl(Term t,uint context=0){ return Proof(t,t,uint.max,context); }
+	private Proof record(Deduction d){
+		if(tracing){ d.proof.id=cast(uint)deductions.length; deductions~=d; }
+		return d.proof;
+	}
+	bool visible(uint outer,uint inner){
+		while(inner!=outer&&inner) inner=contexts[inner].parent;
+		return inner==outer;
+	}
+	Proof trans(Proof p,Proof q,uint context){
+		enforce(p.after==q.before&&visible(p.context,context)&&visible(q.context,context),"invalid derivation composition");
+		if(p.before==p.after){ q.context=context; return q; }
+		if(q.before==q.after){ p.context=context; return p; }
+		auto result=Proof(p.before,q.after,uint.max,context);
+		return tracing?record(Deduction(Evidence.trans,result,[p,q])):result;
+	}
+	Proof congr(Term t,Proof[] children,uint context){
+		auto n=arena.node(t);
+		enforce(n.arity==children.length,"congruence arity mismatch");
+		bool unchanged=true;
+		foreach(i,p;children){
+			enforce(arena.child(t,cast(uint)i)==p.before&&visible(p.context,context),"invalid congruence premise");
+			unchanged=unchanged&&p.before==p.after;
+		}
+		if(unchanged) return refl(t,context);
+		Term[] cs; foreach(p;children) cs~=p.after;
+		auto result=arena.rebuild(t,cs);
+		if(t==result) return refl(t,context);
+		return record(Deduction(Evidence.congr,Proof(t,result,uint.max,context),children));
+	}
+	Proof rule(Instance i,Proof[] premises,uint context){
+		size_t j; DomainProof[] domains;
+		foreach(c;i.conditions){
+			if(c.literal) enforce(arena.isNumber(c.term),"literal premise failed");
+			else if(c.defined){
+				auto d=domain(i.before,c.term);
+				enforce(d.found,"missing definedness premise"); domains~=d;
+			}else{
+				enforce(j<premises.length&&premises[j].before==c.term&&premises[j].after==arena.boolean(true)&&visible(premises[j].context,context),"invalid rule premise");
+				++j;
+			}
+		}
+		enforce(j==premises.length,"unexpected rule premises");
+		auto d=Deduction(Evidence.rule,Proof(i.before,i.result,uint.max,context),premises,i,domains);
+		return record(d);
+	}
+	uint enter(uint parent,Term guard,bool value){
+		enforce(arena.sort(guard)==Sort.boolean,"Boolean assumption expected");
+		contexts~=Context(parent,guard,value);
+		return cast(uint)contexts.length-1;
+	}
+	Proof scoped(Term t,Proof body,uint context){
+		auto n=arena.node(t),s=contexts[body.context];
+		enforce((n.op==Op.mask||n.op==Op.and_||n.op==Op.or_)&&s.parent==context&&s.guard==arena.at(n.a)&&s.value==(n.op!=Op.or_)&&body.before==arena.at(n.b),"invalid guarded derivation");
+		auto result=arena.rebuild(t,[arena.at(n.a),body.after]);
+		if(result==t) return refl(t,context);
+		return record(Deduction(Evidence.scoped,Proof(t,result,uint.max,context),[body]));
+	}
+	Proof assumption(uint assumptionScope,uint[] path,uint context){
+		enforce(assumptionScope&&visible(assumptionScope,context),"invisible assumption");
+		auto t=contexts[assumptionScope].guard; bool value=contexts[assumptionScope].value;
+		foreach(i;path){
+			auto n=arena.node(t);
+			if(n.op==Op.not_){ enforce(i==0,"bad assumption path"); value=!value; }
+			else enforce((n.op==Op.and_&&value||n.op==Op.or_&&!value)&&i<2,"invalid assumption projection");
+			t=arena.child(t,i);
+		}
+		auto p=value?t:arena.not_(t);
+		auto d=Deduction(Evidence.assumption,Proof(p,arena.boolean(true),uint.max,context,true));
+		d.assumptionScope=assumptionScope; d.path=path; d.value=value;
+		return record(d);
+	}
+	Proof transport(Proof known,Proof change,uint context){
+		enforce(known.known&&known.before==change.before,"known value required");
+		auto result=Proof(change.after,known.after,uint.max,context,true);
+		return tracing?record(Deduction(Evidence.transport,result,[known,change])):result;
+	}
+	Proof numeric(Term before,Term after,uint context){
+		foreach(id;arena.postorder(before)){
+			auto n=arena.node(arena.at(id));
+			enforce(n.sort==Sort.real_||n.sort==Sort.complex||n.sort==Sort.boolean,"non-scalar numeric certificate");
+			enforce(n.op!=Op.variable&&n.op!=Op.densityAt,"symbolic numeric certificate");
+		}
+		enforce(arena.isNumber(after)||arena.node(after).op==Op.boolLit,"numeric result expected");
+		if(before==after) return refl(before,context);
+		return record(Deduction(Evidence.numeric,Proof(before,after,uint.max,context)));
+	}
+	private void leaves(Term t,Op op,ref Term[] result){
+		Term[] pending=[t];
+		while(pending.length){
+			t=pending[$-1]; --pending.length;
+			auto n=arena.node(t);
+			if(n.op==op) pending~=[arena.at(n.b),arena.at(n.a)];
+			else if(!(arena.isNumber(t)&&(op==Op.add?arena.number(t).zero:arena.number(t).one))) result~=t;
+		}
+	}
+	Proof ac(Term before,Term after,Op op,uint context){
+		enforce(op==Op.add||op==Op.mul,"AC operation expected");
+		enforce(arena.sort(before)==arena.sort(after),"AC type mismatch");
+		if(before==after) return refl(before,context);
+		Term[] left,right; leaves(before,op,left); leaves(after,op,right);
+		Table!(uint,uint) counts;
+		foreach(t;left) counts.set(t.id,counts.get(t.id,0)+1);
+		foreach(t;right){ auto n=counts.get(t.id,0); enforce(n,"AC leaf mismatch"); counts.set(t.id,n-1); }
+		enforce(left.length==right.length,"AC leaf count mismatch");
+		auto d=Deduction(Evidence.ac,Proof(before,after,uint.max,context)); d.value=op==Op.mul;
+		return record(d);
+	}
+	DomainProof domain(Term source,Term target){
+		Table!(uint,uint) known;
+		struct Entry{ Term term; uint[] path; }
+		Entry[] pending=[Entry(source)]; uint[][] paths;
+		while(pending.length){
+			auto e=pending[$-1]; --pending.length;
+			if(known.contains(e.term.id)) continue;
+			known.set(e.term.id,cast(uint)paths.length); paths~=e.path;
+			auto n=arena.node(e.term);
+			if(n.arity>=1) pending~=Entry(arena.at(n.a),e.path~0u);
+			if(n.arity==2&&n.op!=Op.mask&&n.op!=Op.and_&&n.op!=Op.or_) pending~=Entry(arena.at(n.b),e.path~1u);
+		}
+		DomainProof build(Term t,uint depth=0){
+			DomainProof d; d.term=t;
+			auto i=known.get(t.id,uint.max);
+			if(i!=uint.max){ d.found=true; d.path=paths[i]; return d; }
+			auto n=arena.node(t);
+			if(n.arity==0){ d.found=d.total=true; return d; }
+			if(depth>=128||n.op==Op.inv||n.op==Op.mask||n.op==Op.and_||n.op==Op.or_) return d;
+			foreach(j;0..n.arity){
+				auto child=build(arena.child(t,j),depth+1);
+				if(!child.found) return d;
+				d.children~=child;
+			}
+			d.found=true; return d;
+		}
+		return build(target);
+	}
+}
diff --git a/engine.d b/engine.d
new file mode 100644
index 0000000000000000000000000000000000000000..98a9afd4107bdf7ba4c1386514375a9312968da6
--- /dev/null
+++ b/engine.d
@@ -0,0 +1,166 @@
+module qsym.engine;
+import qsym.ir;
+import qsym.derive;
+import qsym.budget;
+import qsym.field:Field;
+import qsym.generated.rules;
+import qsym.table:Table;
+@safe:
+
+package final class Engine{
+	private Arena a;
+	private Derivation d;
+	private Budget budget;
+	private Field field;
+	private size_t rewritesLeft;
+	private uint depth;
+	private Table!(ulong,uint) memo,truths;
+	private Proof[] proofs;
+	private uint[] roots;
+	private Table!(ulong,bool) active,proving;
+	private Proof[][] facts=[[]];
+	this(Arena a,Derivation d,Budget budget,size_t rewrites){
+		this.a=a; this.d=d; this.budget=budget; rewritesLeft=rewrites;
+		field=new Field(a,d,budget,&normalize);
+	}
+	private void remember(ref Table!(ulong,uint) index,ulong key,Proof p){
+		index.set(key,cast(uint)proofs.length); proofs~=p;
+	}
+	private void memoize(ulong key,Proof p){
+		if(key>uint.max){ remember(memo,key,p); return; }
+		if(key>=roots.length) roots.length=cast(size_t)key+1;
+		roots[cast(uint)key]=cast(uint)proofs.length+1; proofs~=p;
+	}
+	private ulong key(Term t,uint ctx,bool probe=false){ return (cast(ulong)ctx<<33)|(cast(ulong)probe<<32)|t.id; }
+	private Proof normalize(Term t,uint ctx){ return go(t,ctx); }
+	private Proof[] known(uint ctx){
+		Proof[] result;
+		while(ctx){ result~=facts[ctx]; ctx=d.contexts[ctx].parent; }
+		return result;
+	}
+	private uint enter(uint parent,Term guard,bool value){
+		budget.spend();
+		auto ctx=d.enter(parent,guard,value);
+		facts.length=d.contexts.length;
+		struct Item{ Term term; bool value; uint[] path; }
+		Item[] pending=[Item(guard,value)];
+		while(pending.length){
+			budget.spend(); auto item=pending[$-1]; --pending.length;
+			auto p=d.assumption(ctx,item.path,ctx);
+			facts[ctx]~=p; remember(truths,key(p.before,ctx),p);
+			auto n=a.node(item.term);
+			if(n.op==Op.not_) pending~=Item(a.at(n.a),!item.value,item.path~0u);
+			else if(n.op==Op.and_&&item.value||n.op==Op.or_&&!item.value)
+				pending~=[Item(a.at(n.b),item.value,item.path~1u),Item(a.at(n.a),item.value,item.path~0u)];
+		}
+		// Normalize strong assumptions and retain their proofs. This matters
+		// for a false disjunct, e.g. ¬(x<0) becoming 0≤x.
+		auto original=facts[ctx].dup;
+		foreach(p;original){
+			auto q=go(p.before,ctx,true);
+			if(q.after!=p.before){ auto f=d.transport(p,q,ctx); facts[ctx]~=f; remember(truths,key(f.before,ctx),f); }
+		}
+		return ctx;
+	}
+	private bool instanceProof(Instance i,uint ctx,out Proof result){
+		Proof[] premises;
+		foreach(c;i.conditions){
+			budget.spend();
+			if(c.literal){ if(!a.isNumber(c.term)) return false; }
+			else if(c.defined){ if(!d.domain(i.before,c.term).found) return false; }
+			else{
+				Proof p; if(!prove(c.term,ctx,p)) return false;
+				premises~=p;
+			}
+		}
+		if(!rewritesLeft) throw new Limit;
+		--rewritesLeft;
+		result=d.rule(i,premises,ctx); return true;
+	}
+	private bool complete(Law law,Term[] bindings,uint ctx,out Proof result,uint nesting=0){
+		budget.spend(); if(nesting>=128) return false;
+		size_t missing; foreach(b;bindings) if(b.id==uint.max) ++missing;
+		if(!missing) return instanceProof(instantiate(a,law,bindings),ctx,result);
+		auto available=known(ctx);
+		foreach(i;0..conditionCount(law)) foreach(f;available){
+			budget.spend(); auto bs=bindings.dup;
+			if(!match(a,law,cast(int)i,f.before,bs)) continue;
+			size_t rest; foreach(b;bs) if(b.id==uint.max) ++rest;
+			if(rest>=missing) continue;
+			if(complete(law,bs,ctx,result,nesting+1)) return true;
+		}
+		return false;
+	}
+	private bool attempt(Law law,Term t,uint ctx,out Proof result){
+		budget.spend(); Term[] bindings;
+		return match(a,law,-1,t,bindings)&&complete(law,bindings,ctx,result);
+	}
+	private bool prove(Term t,uint ctx,out Proof result){
+		budget.spend();
+		auto k=key(t,ctx);
+		if(truths.contains(k)){ result=proofs[truths.get(k,uint.max)]; return true; }
+		foreach(f;known(ctx)) if(f.before==t){ result=f; return true; }
+		if(t==a.boolean(true)){ result=d.refl(t,ctx); return true; }
+		if(proving.get(k,false)) return false;
+		proving.set(k,true); scope(exit) proving.set(k,false);
+		foreach(law;inferences(a.node(t).op)) if(attempt(law,t,ctx,result)){
+			remember(truths,k,result); return true;
+		}
+		auto p=go(t,ctx,true);
+		if(p.after==a.boolean(true)){ result=p; remember(truths,k,result); return true; }
+		if(p.after!=t){
+			Proof q;
+			if(prove(p.after,ctx,q)){ result=d.trans(p,q,ctx); remember(truths,k,result); return true; }
+		}
+		return false;
+	}
+	Proof go(Term t,uint ctx=0,bool probe=false){
+		auto k=key(t,ctx,probe);
+		auto cached=k<=uint.max?(t.id<roots.length?roots[t.id]:0):memo.get(k,uint.max)+1;
+		if(cached) return proofs[cached-1];
+		if(active.get(k,false)) return d.refl(t,ctx);
+		if(!rewritesLeft){ budget.exhausted=true; return d.refl(t,ctx); }
+		try{
+			if(depth>=128) throw new Limit;
+			++depth; scope(exit) --depth;
+			budget.spend(); active.set(k,true); scope(exit) active.set(k,false);
+			auto n=a.node(t); Proof[] cs;
+			foreach(i;0..n.arity) cs~=go(a.child(t,i),ctx,probe);
+			auto p=d.congr(t,cs,ctx);
+			auto current=p.after; n=a.node(current);
+			if(ctx&&!probe&&n.sort==Sort.real_&&!a.isNumber(current)){
+				auto i=instantiate(a,Law.real_known_zero,[current]); Proof q;
+				if(instanceProof(i,ctx,q)){ p=d.trans(p,q,ctx); memoize(k,p); return p; }
+			}
+			if(!probe&&n.sort==Sort.boolean){
+				Proof q;
+				if(prove(current,ctx,q)){ p=d.trans(p,q,ctx); memoize(k,p); return p; }
+				if(prove(a.not_(current),ctx,q)){
+					auto f=d.rule(instantiate(a,Law.bool_false,[current]),[q],ctx);
+					p=d.trans(p,f,ctx); memoize(k,p); return p;
+				}
+			}
+			auto numeric=field.literal(current,ctx);
+			if(numeric.after!=current){ p=d.trans(p,numeric,ctx); memoize(k,p); return p; }
+			foreach(law;rewrites(n.op)){
+				Proof q;
+				if(attempt(law,current,ctx,q)&&q.after!=current){
+					p=d.trans(p,q,ctx); p=d.trans(p,go(p.after,ctx,probe),ctx);
+					memoize(k,p); return p;
+				}
+			}
+			if(n.op==Op.mask||n.op==Op.and_||n.op==Op.or_){
+				auto c=enter(ctx,a.at(n.a),n.op!=Op.or_);
+				auto q=go(a.at(n.b),c,probe);
+				if(q.after!=q.before){
+					p=d.trans(p,d.scoped(current,q,ctx),ctx);
+					p=d.trans(p,go(p.after,ctx,probe),ctx); memoize(k,p); return p;
+				}
+			}
+			auto q=field.run(current,ctx);
+			p=d.trans(p,q,ctx);
+			if(q.after!=current) p=d.trans(p,go(p.after,ctx,probe),ctx);
+			memoize(k,p); return p;
+		}catch(Limit e){ budget.exhausted=true; return d.refl(t,ctx); }
+	}
+}
diff --git a/field.d b/field.d
new file mode 100644
index 0000000000000000000000000000000000000000..f8fa733023934ba09b9c93e798b608bdcafda034
--- /dev/null
+++ b/field.d
@@ -0,0 +1,395 @@
+module qsym.field;
+import qsym.ir;
+import qsym.derive;
+import qsym.budget;
+import qsym.generated.rules;
+import qsym.table:Table;
+import std.algorithm:sort;
+import std.exception:enforce;
+@safe:
+
+int compare(Arena a,Term x,Term y){
+	Term[] left=[x],right=[y];
+	while(left.length){
+		x=left[$-1]; y=right[$-1]; --left.length; --right.length;
+		if(x==y) continue;
+		auto l=a.node(x),r=a.node(y);
+		if(l.sort!=r.sort) return l.sort<r.sort?-1:1;
+		if(l.op!=r.op) return l.op<r.op?-1:1;
+		if(a.isNumber(x)){
+			auto u=a.number(x),v=a.number(y),c=u.re.opCmp(v.re);
+			if(c) return c;
+			return u.im.opCmp(v.im);
+		}
+		if(l.value!=r.value) return l.value<r.value?-1:1;
+		if(l.arity==2){ left~=a.at(l.b); right~=a.at(r.b); }
+		if(l.arity>=1){ left~=a.at(l.a); right~=a.at(r.a); }
+	}
+	return 0;
+}
+
+private struct Factor{ Term atom; long exponent; }
+private struct Mono{ Number coefficient; Factor[] factors; }
+
+// The algorithms choose normal forms. Every changed expression is accompanied
+// by applications of generated laws, congruence, AC permutations or arithmetic.
+package final class Field{
+	private Arena a;
+	private Derivation d;
+	private Budget budget;
+	private Proof delegate(Term,uint) @safe norm;
+	private uint divisions;
+	this(Arena a,Derivation d,Budget budget,Proof delegate(Term,uint) @safe norm){
+		this.a=a; this.d=d; this.budget=budget; this.norm=norm;
+	}
+	private Proof law(string name)(Sort s,Term[] args,uint ctx){
+		budget.spend();
+		auto id=s==Sort.real_?__traits(getMember,Law,"real_"~name):__traits(getMember,Law,"complex_"~name);
+		return d.rule(instantiate(a,id,args),[],ctx);
+	}
+	private Proof then(Proof p,Proof q,uint ctx){ return d.trans(p,q,ctx); }
+	private Term number(long x,Sort s){ return a.number(Number(x),s); }
+	private Term balanced(Term[] ts,Op op,Sort s){
+		if(!ts.length) return number(op==Op.add?0:1,s);
+		while(ts.length>1){
+			Term[] next;
+			for(size_t i;i<ts.length;i+=2) next~=i+1==ts.length?ts[i]:op==Op.add?a.add(ts[i],ts[i+1]):a.mul(ts[i],ts[i+1]);
+			ts=next;
+		}
+		return ts[0];
+	}
+	private Term[] leaves(Term t,Op op){
+		Term[] result,pending=[t];
+		while(pending.length){
+			budget.spend(); t=pending[$-1]; --pending.length;
+			auto n=a.node(t);
+			if(n.op==op) pending~=[a.at(n.b),a.at(n.a)]; else result~=t;
+		}
+		return result;
+	}
+	private Term factorTerm(Factor f,Sort s){
+		auto e=f.exponent<0?-f.exponent:f.exponent;
+		if(e>uint.max) throw new Limit;
+		auto t=e==1?f.atom:a.pow(f.atom,cast(uint)e);
+		return f.exponent<0?a.inv(t):t;
+	}
+	private Factor factor(Term t){
+		long sign=1; auto n=a.node(t);
+		if(n.op==Op.inv){ sign=-1; t=a.at(n.a); n=a.node(t); }
+		return n.op==Op.pow?Factor(a.at(n.a),sign*n.value):Factor(t,sign);
+	}
+	private Term base(Mono m,Sort s){
+		Term[] fs; foreach(f;m.factors) fs~=factorTerm(f,s);
+		return balanced(fs,Op.mul,s);
+	}
+	private Term emit(Mono m,Sort s){
+		if(m.coefficient.zero) return number(0,s);
+		Term[] fs;
+		if(!m.coefficient.one||!m.factors.length) fs~=a.number(m.coefficient,s);
+		foreach(f;m.factors) fs~=factorTerm(f,s);
+		return balanced(fs,Op.mul,s);
+	}
+	private Mono mono(Term t){
+		Mono m; m.coefficient=Number(1);
+		foreach(f;leaves(t,Op.mul)){
+			if(a.isNumber(f)) m.coefficient=budget.calc!"*"(m.coefficient,a.number(f));
+			else m.factors~=factor(f);
+		}
+		sort!((x,y)=>compare(a,x.atom,y.atom)<0)(m.factors);
+		return m;
+	}
+	private int order(Mono x,Mono y){
+		long dx,dy; foreach(f;x.factors) dx+=f.exponent; foreach(f;y.factors) dy+=f.exponent;
+		if(dx!=dy) return dx<dy?-1:1;
+		size_t i,j;
+		while(i<x.factors.length||j<y.factors.length){
+			if(i==x.factors.length) return y.factors[j].exponent>0?-1:1;
+			if(j==y.factors.length) return x.factors[i].exponent>0?1:-1;
+			auto c=compare(a,x.factors[i].atom,y.factors[j].atom);
+			if(c) return c<0?(x.factors[i].exponent>0?1:-1):(y.factors[j].exponent>0?-1:1);
+			auto ex=x.factors[i++].exponent,ey=y.factors[j++].exponent;
+			if(ex!=ey) return ex<ey?-1:1;
+		}
+		return 0;
+	}
+	Proof literal(Term t,uint ctx){
+		auto n=a.node(t);
+		if(!n.arity) return d.refl(t,ctx);
+		auto x=a.at(n.a); if(!a.isNumber(x)) return d.refl(t,ctx);
+		auto v=a.number(x); Number w;
+		if(n.arity==2){ if(!a.isNumber(a.at(n.b))) return d.refl(t,ctx); w=a.number(a.at(n.b)); }
+		Term result;
+		switch(n.op){
+			case Op.add:result=a.number(budget.calc!"+"(v,w),n.sort); break;
+			case Op.mul:result=a.number(budget.calc!"*"(v,w),n.sort); break;
+			case Op.inv:if(v.zero) return d.refl(t,ctx); result=a.number(budget.calc!"/"(Number(1),v),n.sort); break;
+			case Op.pow:
+				if(!n.value) return law!"pow_zero"(n.sort,[x],ctx);
+				if(n.value==1) return law!"pow_one"(n.sort,[x],ctx);
+				auto m=n.value/2;
+				auto p=law!"pow_split"(n.sort,[x,a.real_(m),a.real_(n.value-m)],ctx);
+				auto l=norm(a.child(p.after,0),ctx),r=norm(a.child(p.after,1),ctx);
+				if(budget.exhausted) throw new Limit;
+				p=then(p,d.congr(p.after,[l,r],ctx),ctx);
+				return then(p,literal(p.after,ctx),ctx);
+			case Op.conj:result=a.number(v.conjugate,n.sort); break;
+			case Op.abs:result=a.number(v.re<Rational(0)?-v:v,n.sort); break;
+			case Op.nonzero:result=a.boolean(!v.zero); break;
+			case Op.lt:result=a.boolean(v.re<w.re); break;
+			case Op.le:result=a.boolean(v.re<=w.re); break;
+			default:return d.refl(t,ctx);
+		}
+		return d.numeric(t,result,ctx);
+	}
+	private Proof powerView(Term t,uint ctx){
+		auto f=factor(t),s=a.sort(t);
+		auto e=f.exponent<0?-f.exponent:f.exponent;
+		auto p=d.refl(f.atom,ctx);
+		if(e==1){
+			auto i=instantiate(a,s==Sort.real_?Law.real_power_one:Law.complex_power_one,[f.atom]);
+			auto old=i.before; i.before=i.result; i.result=old; i.reversed=true;
+			p=d.rule(i,[],ctx);
+		}else p=d.refl(a.pow(f.atom,cast(uint)e),ctx);
+		return f.exponent<0?d.congr(t,[p],ctx):p;
+	}
+	private Proof joinFactors(Term x,Term y,uint ctx){
+		auto s=a.sort(x),u=factor(x),v=factor(y);
+		enforce(u.atom==v.atom,"different factor bases");
+		if(u.exponent+v.exponent>uint.max||u.exponent+v.exponent<-(cast(long)uint.max)) throw new Limit;
+		auto t=a.mul(x,y),p=d.congr(t,[powerView(x,ctx),powerView(y,ctx)],ctx);
+		auto m=u.exponent<0?-u.exponent:u.exponent,n=v.exponent<0?-v.exponent:v.exponent;
+		auto pm=a.pow(u.atom,cast(uint)m),pn=a.pow(u.atom,cast(uint)n);
+		if(u.exponent>=0&&v.exponent>=0){
+			p=then(p,law!"pow_join"(s,[u.atom,a.real_(m),a.real_(n)],ctx),ctx);
+		}else if(u.exponent<0&&v.exponent<0){
+			p=then(p,law!"mul_inv"(s,[pm,pn],ctx),ctx);
+			p=then(p,d.congr(p.after,[law!"pow_join"(s,[u.atom,a.real_(m),a.real_(n)],ctx)],ctx),ctx);
+		}else{
+			if(u.exponent<0){
+				auto swap=a.mul(pn,a.inv(pm)); p=then(p,d.ac(p.after,swap,Op.mul,ctx),ctx);
+				auto k=m; m=n; n=k;
+			}
+			auto positive=a.pow(u.atom,cast(uint)m),negative=a.pow(u.atom,cast(uint)n);
+			if(m>=n){
+				auto split=law!"pow_split"(s,[u.atom,a.real_(n),a.real_(m-n)],ctx);
+				p=then(p,d.congr(p.after,[split,d.refl(a.inv(negative),ctx)],ctx),ctx);
+				auto rest=a.pow(u.atom,cast(uint)(m-n));
+				auto grouped=a.mul(a.mul(negative,a.inv(negative)),rest);
+				p=then(p,d.ac(p.after,grouped,Op.mul,ctx),ctx);
+				p=then(p,d.congr(grouped,[law!"div_self"(s,[negative],ctx),d.refl(rest,ctx)],ctx),ctx);
+				p=then(p,d.ac(p.after,rest,Op.mul,ctx),ctx);
+			}else{
+				auto split=law!"pow_split"(s,[u.atom,a.real_(m),a.real_(n-m)],ctx);
+				p=then(p,d.congr(p.after,[d.refl(positive,ctx),d.congr(a.inv(negative),[split],ctx)],ctx),ctx);
+				auto rest=a.pow(u.atom,cast(uint)(n-m));
+				p=then(p,d.congr(p.after,[d.refl(positive,ctx),law!"inv_mul"(s,[positive,rest],ctx)],ctx),ctx);
+				auto grouped=a.mul(a.mul(positive,a.inv(positive)),a.inv(rest));
